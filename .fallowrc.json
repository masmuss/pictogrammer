{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["astro.config.ts"],
	"ignorePatterns": ["public/github-card.js"],
	"ignoreDependencies": [
		"@iconify/json",
		"@iconify-json/ph",
		"@astrojs/markdown-remark",
		"@astrojs/sitemap",
		"@richardtowers/remark-abbr",
		"@tailwindcss/vite",
		"astro-pagefind",
		"lodash-es",
		"rehype-external-links",
		"remark-deflist",
		"remark-directive",
		"remark-supersub"
	],
	"rules": {
		"unused-types": "warn"
	}
}
