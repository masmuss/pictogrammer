/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://giscus.app https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data: https:; font-src 'self'; frame-src https://giscus.app; connect-src 'self' https://giscus.app https://cloudflareinsights.com; frame-ancestors 'none'

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# Giscus loads these cross-origin from the giscus.app iframe via fetch,
# which requires CORS. Without this the custom theme silently fails and
# the widget falls back to unstyled native controls.
/giscus-light.css
  Access-Control-Allow-Origin: *
/giscus-dark.css
  Access-Control-Allow-Origin: *
