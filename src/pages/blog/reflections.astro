---
export const prerender = true;

import BlogListLayout from "@/components/features/blog/BlogListLayout.astro";
import { getPostsByPath } from "@/lib/contents";

const reflectionPosts = await getPostsByPath("reflections");
---

<BlogListLayout
  activeTab="reflections"
  title="Reflections"
  description="Personal reflections on perspective, resilience, identity, and growth."
  image={{ src: "/og/reflections.png", alt: "Reflections - pictogrammmer" }}
  posts={reflectionPosts}
/>
