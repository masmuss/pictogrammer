---
import type { CollectionEntry } from "astro:content";
import BlogTabs from "@/components/features/blog/BlogTabs.astro";
import { Card } from "@/components/ui/card";
import Heading from "@/components/ui/Heading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllSeries } from "@/lib/contents";
import { cn } from "@/lib/utils";

const allSeries = await getAllSeries();
type SeriesEntry = CollectionEntry<"series">;
---

<BaseLayout
	title="Learning Series and Writing Collections"
	description="Discover grouped writing series that help you learn a topic step by step, from Astro and Go fundamentals to deeper engineering concepts and practices."
	image={{ src: "/og/series.png", alt: "Series - pictogrammmer" }}
>
	<div class="flex w-full flex-col gap-y-8">
		<Heading as="h1" class="sr-only">Series</Heading>
		<div class="flex w-full flex-col">
			<BlogTabs activeTab="series" />

			<div class="flex max-w-xl flex-col">
				<p class="text-muted-foreground">
					{allSeries.length} series available
				</p>
			</div>
		</div>

		{
			allSeries.length === 0 && (
				<p class="text-muted-foreground">No series yet.</p>
			)
		}

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
			{
				allSeries.map((series: SeriesEntry) => (
					<Card
						as="a"
						variant="interactive"
						href={`/blog/series/${series.id}`}
						class={cn(
							"bg-secondary/30 hover:bg-secondary/50 mx-0 flex flex-col gap-y-2"
						)}
						data-testid="series-item"
					>
						<Heading
							as="h2"
							weight="semibold"
							size="lg"
							class="group-hover/interactive:text-primary transition-colors"
						>
							{series.data.title}
						</Heading>
						<p class="text-muted-foreground line-clamp-2 text-sm">
							{series.data.description}
						</p>
					</Card>
				))
			}
		</div>
	</div>
</BaseLayout>
