---
export const prerender = true;

import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import BlogListLayout from "@/components/features/blog/BlogListLayout.astro";
import Paginator from "@/components/ui/Paginator.astro";
import { getAllPosts } from "@/lib/contents";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const allPosts = await getAllPosts();
	return paginate(allPosts, { pageSize: 10 });
};

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← Newer Posts",
			url: page.url.prev
		}
	}),
	...(page.url.next && {
		nextUrl: {
			text: "Older Posts →",
			url: page.url.next
		}
	})
};
---

<BlogListLayout
	activeTab="posts"
	title={`Blog Archive${page.currentPage > 1 ? ` - Page ${page.currentPage}` : ""}`}
	description={`Browse all blog posts${page.currentPage > 1 ? ` (page ${page.currentPage} of ${page.lastPage})` : ""} — practical notes, tutorials, and reflective writing by Khoirul Fattah.`}
	image={{ src: "/og/blog.png", alt: "Blog - pictogrammmer" }}
	posts={page.data}
>
	<div slot="after-posts">
		<Paginator {...paginationProps} />
	</div>
</BlogListLayout>
