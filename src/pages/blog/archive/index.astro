---
export const prerender = true;

import ArchiveSidebar from "@/components/features/blog/ArchiveSidebar.astro";
import BlogTabs from "@/components/features/blog/BlogTabs.astro";
import PostPreview from "@/components/features/blog/PostPreview.astro";
import Heading from "@/components/ui/Heading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts, groupPostsForArchive } from "@/lib/contents";

const title = "Blog Archive";
const description =
	"Browse all blog posts by Khoirul Fattah, organized by year and month.";
const allPosts = await getAllPosts();

const archiveData = groupPostsForArchive(allPosts);
---

<BaseLayout
  {title}
  {description}
  image={{ src: "/og/blog.png", alt: "Blog - pictogrammmer" }}
  pageType="website"
>
  <div class="flex w-full flex-col gap-y-12">
    <Heading as="h1" class="sr-only">{title}</Heading>
    <div class="flex w-full flex-col">
      <BlogTabs activeTab="posts" />

      <div class="flex max-w-xl flex-col">
        <p class="text-muted-foreground">{description}</p>
      </div>
    </div>

    {
      allPosts.length === 0 && (
        <p class="text-muted-foreground">No posts yet.</p>
      )
    }

    {
      allPosts.length > 0 && (
        <div class="relative grid grid-cols-1 gap-8 lg:grid-cols-[1fr_0.5fr]">
          {/* Main Content */}
          <div class="flex flex-col gap-y-20">
            {archiveData.map(({ year, months }) => (
              <section class="flex flex-col gap-y-8" id={`year-${year}`}>
                <h2 class="relative text-2xl font-bold tracking-tight md:text-2xl">
                  <span class="text-muted-foreground/10 absolute -top-8 -left-4 -z-10 text-7xl select-none md:-top-10 md:-left-6 md:text-8xl">
                    {year}
                  </span>
                </h2>
                <div class="flex flex-col gap-y-12">
                  {months.map(({ month, monthName, posts }) => (
                    <div
                      class="flex flex-col gap-y-4"
                      id={`month-${year}-${month}`}
                    >
                      <h3 class="text-muted-foreground text-xl font-semibold">
                        {monthName}
                      </h3>
                      <ul class="group/list relative flex flex-col">
                        {posts.map((post) => (
                          <PostPreview post={post} showDescription />
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <ArchiveSidebar
            archiveData={archiveData}
            class="sticky top-0 w-full self-start"
          />
        </div>
      )
    }
  </div>
</BaseLayout>
