---
export const prerender = true;

import { render } from "astro:content";
import PostLayout from "@/layouts/BlogPost.astro";
import { getAllPosts, getRelatedPosts } from "@/lib/contents/post";
import { getPostRouteId } from "@/lib/utils/post-route";
import type { CollectionPosts } from "@/types";

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post: CollectionPosts) => ({
		params: { id: getPostRouteId(post) },
		props: { post },
	}));
}

const { post } = Astro.props;

if (post.data.externalUrl) {
	return Astro.redirect(post.data.externalUrl);
}

const { Content } = await render(post);
const relatedPosts = getRelatedPosts(await getAllPosts(), post);
---

<PostLayout {relatedPosts} post={post}>
	<div class="custom-prose">
		<Content />
	</div>
</PostLayout>
