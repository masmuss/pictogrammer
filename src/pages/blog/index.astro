---
export const prerender = true;

import BlogListLayout from "@/components/features/blog/BlogListLayout.astro";
import { getPostsByPath } from "@/lib/contents";

const allPosts = await getPostsByPath();

const blogBreadcrumbs = [
	{ name: "Home", item: new URL("/", Astro.site).href },
	{ name: "Blog", item: new URL("/blog", Astro.site).href }
];
---

<BlogListLayout
	activeTab="posts"
	title="Blog: Notes, Reflections, and Series"
	description="Browse all blog posts by Khoirul Fattah, from software engineering notes and project write-ups to reflective essays about growth, craft, and life lessons."
	image={{ src: "/og/blog.png", alt: "Blog - pictogrammmer" }}
	posts={allPosts}
	breadcrumbs={blogBreadcrumbs}
/>
