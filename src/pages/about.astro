---
export const prerender = true;

import Section from "@/components/common/Section.astro";
import SocialLinks from "@/components/common/SocialLinks.astro";
import Experiences from "@/components/features/about/Experiences.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllExperiences } from "@/lib/contents";
import AboutContent from "../../content/pages/about.md";

const experiences = await getAllExperiences();
---

<BaseLayout
	title="About Khoirul Fattah"
	description="Learn about Khoirul Fattah, a full-stack developer and photographer based in Surabaya, including his experience and current focus."
	image={{ src: "/og/about.png", alt: "About - pictogrammmer" }}
	pageType="website"
	breadcrumbs={[
		{ name: "Home", item: new URL("/", Astro.site).href },
		{ name: "About", item: new URL("/about", Astro.site).href }
	]}
>
	<div class="flex w-full flex-col gap-y-16">
		<div class="flex flex-col gap-y-16">
			<Section
				title="About Me"
				titleAs="h1"
				titleSize="2xl"
				titleWeight="bold"
				transitionDelay={0}
				class="pt-0"
				data-testid="about-me-section"
			>
				<div
					class="custom-prose prose-a:underline max-w-none underline-offset-2"
				>
					<AboutContent />
				</div>
			</Section>

			<Section
				title="Experiences"
				titleAs="h2"
				transitionDelay={150}
				data-testid="experiences-section"
			>
				<Experiences experiences={experiences} />
			</Section>

			<Section
				title="Get in Touch"
				titleAs="h2"
				transitionDelay={150}
				data-testid="get-in-touch-section"
			>
				<div class="text-muted-foreground flex flex-col gap-y-4">
					<p>
						Feel free to reach out if you want to collaborate, have a project in
						mind, or just want to say hi!
					</p>
					<div class="flex flex-wrap items-center gap-3">
						<SocialLinks showEmail showCV />
					</div>
				</div>
			</Section>
		</div>
	</div>
</BaseLayout>
