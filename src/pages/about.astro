---
import SocialLinks from "@/components/common/SocialLinks.astro";
import Certifications from "@/components/features/about/Certifications.astro";
import Educations from "@/components/features/about/Educations.astro";
import Experiences from "@/components/features/about/Experiences.astro";
import GitHubCalendar from "@/components/features/about/GitHubCalendar.astro";
import SkillsTabs from "@/components/features/about/SkillsTabs.astro";
import AsideListPanel from "@/components/ui/AsideListPanel.astro";
import Heading from "@/components/ui/Heading.astro";
import Section from "@/components/ui/Section.astro";
import siteConfig from "@/config/site-config";
import AboutContent from "@/content/pages/about.md";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TECH_STACK from "@/lib/constants/tech-stack";
import { getAboutPageData } from "@/lib/contents";

const { experiences, educations, certifications } = await getAboutPageData();
const currentWork = experiences.slice(0, 1);

const currentWorkItems = currentWork.map((work) => ({
	title: work.title,
	meta: work.company
}));

const learningFocusItems = [
	{
		title: "Backend engineering",
		meta: "APIs, background jobs, scaling"
	},
	{
		title: "Data architecture",
		meta: "PostgreSQL, Redis, caching"
	},
	{
		title: "Observability",
		meta: "Logs, metrics, tracing"
	}
];

const nowReadingBooks = [
	{
		title: "The Alchemist",
		meta: "Paulo Coelho"
	},
	{
		title: "Pulang",
		meta: "Leila S. Chudori"
	}
];

const githubProfile = siteConfig.socialLinks.find(
	(social) => social.text === "GitHub"
)?.href;
const githubUsername =
	githubProfile?.split("/").filter(Boolean).at(-1) ?? "masmuss";

const githubCalendarTheme = {
	light: ["#E6E4D9", "#DDE2B2", "#BEC97E", "#A0AF54", "#879A39"],
	dark: ["#282726", "#3D4C07", "#536907", "#66800B", "#879A39"]
} as const;
---

<BaseLayout
	title="About Khoirul Fattah"
	description="Learn about Khoirul Fattah, a full-stack developer and photographer based in Surabaya, including experience, skills, education, certifications, and current focus."
	image={{ src: "/og/about.png", alt: "About - pictogrammmer" }}
	pageType="website"
>
	<div class="flex w-full flex-col gap-y-10">
		<Heading as="h1" class="sr-only">About Khoirul Fattah</Heading>

		<div
			class="grid w-full grid-cols-1 gap-8 lg:grid-cols-[minmax(0,5fr)_256px] lg:gap-12"
		>
			<div class="flex flex-col gap-y-10">
				<Section
					title="About Me"
					titleAs="h2"
					titleSize="2xl"
					titleWeight="bold"
					transitionDelay={0}
					data-testid="about-me-section"
				>
					<div
						class="custom-prose prose-a:underline max-w-none underline-offset-2"
					>
						<AboutContent />
					</div>
				</Section>

				<Section
					title="Contribution Activity"
					titleUppercase
					titleAs="h2"
					transitionDelay={150}
					data-testid="contribution-activity-section"
				>
					<GitHubCalendar
						username={githubUsername}
						blockSize={10}
						blockMargin={2}
						showMonthLabels={true}
						year="last"
						theme={githubCalendarTheme}
					/>
				</Section>
			</div>

			<div class="flex flex-col gap-6">
				<AsideListPanel
					title="Current Work"
					items={currentWorkItems}
					data-testid="current-work-panel"
				/>
				<AsideListPanel
					title="Currently Learning & Focus"
					items={learningFocusItems}
					data-testid="learning-focus-panel"
				/>
				<AsideListPanel
					title="Now Reading"
					items={nowReadingBooks}
					data-testid="now-reading-panel"
				/>
			</div>
		</div>

		<Section
			title="Skills"
			titleAs="h2"
			titleUppercase
			transitionDelay={150}
			data-testid="skills-section"
		>
			<SkillsTabs collections={TECH_STACK} />
		</Section>

		<Section
			title="Experiences"
			titleAs="h2"
			titleUppercase
			transitionDelay={150}
			data-testid="experiences-section"
		>
			<Experiences experiences={experiences} />
		</Section>

		<Section
			title="Educations"
			titleAs="h2"
			titleUppercase
			transitionDelay={150}
			data-testid="educations-section"
		>
			<Educations educations={educations} />
		</Section>

		<Section
			title="Certifications"
			titleAs="h2"
			titleUppercase
			transitionDelay={150}
			data-testid="certifications-section"
		>
			<Certifications certifications={certifications} />
		</Section>

		<Section
			title="Get in Touch"
			titleAs="h2"
			titleUppercase
			transitionDelay={150}
			data-testid="get-in-touch-section"
		>
			<div class="text-muted-foreground flex flex-col gap-y-4">
				<p>
					Feel free to reach out if you want to collaborate, have a project in
					mind, or just want to say hi!
				</p>
				<SocialLinks variant="button" showEmail />
			</div>
		</Section>
	</div>
</BaseLayout>
