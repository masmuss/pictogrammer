---
export const prerender = true;

import PageHeader from "@/components/common/PageHeader.astro";
import Section from "@/components/common/Section.astro";
import ProjectRow from "@/components/features/projects/ProjectRow.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllProjects, getFeaturedProjects } from "@/lib/contents";
import type { Project } from "@/types";

const allProjects = await getAllProjects();
const featured = await getFeaturedProjects(5);

const featuredTexts = new Set(featured.map((p) => p.text));
const rest: Project[] = allProjects
	.flatMap((category) => category.projects)
	.filter((p) => !featuredTexts.has(p.text));
---

<BaseLayout
	title="Projects in Web and Backend Development"
	description="Browse selected projects built by Khoirul Fattah, including web applications, backend services, and technical experiments focused on real-world problem solving."
	breadcrumbs={[
		{ name: "Home", item: new URL("/", Astro.site).href },
		{ name: "Projects", item: new URL("/projects", Astro.site).href }
	]}
	image={{ src: "/og/projects.png", alt: "Projects - pictogrammmer" }}
	pageType="website"
>
	<div class="flex w-full flex-col gap-y-16">
		<PageHeader
			title="Projects"
			description="A collection of projects I've worked on, from web applications to experiments."
			as="h1"
		/>

		<Section title="Featured" titleAs="h2" class="pt-0">
			<ul class="flex flex-col">
				{featured.map((project) => (
					<ProjectRow project={project} featured />
				))}
			</ul>
		</Section>

		<Section title="More Projects" titleAs="h2" class="pt-0">
			<ul class="flex flex-col">
				{rest.map((project) => (
					<ProjectRow project={project} />
				))}
			</ul>
		</Section>
	</div>
</BaseLayout>
