---
export const prerender = true;

import ProjectCard from "@/components/features/projects/ProjectCard.astro";
import PageHeader from "@/components/common/PageHeader.astro";
import Section from "@/components/common/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllProjects } from "@/lib/contents/projects";

const allProjects = await getAllProjects();
---

<BaseLayout
	title="Projects in Web and Backend Development"
	description="Browse selected projects built by Khoirul Fattah, including web applications, backend services, and technical experiments focused on real-world problem solving."
	image={{ src: "/og/projects.png", alt: "Projects - pictogrammmer" }}
	pageType="website"
>
	<div class="flex w-full flex-col gap-y-10">
		<PageHeader
			title="Projects"
			description="A collection of projects I've worked on, from web applications to experiments."
			as="h1"
			class="mb-6"
		/>

		{
			allProjects.map((category, index) => (
				<Section
					class="gap-y-4 relative mt-12 first:mt-0"
					transitionDelay={index * 150}
				>
					<div class="pointer-events-none absolute -top-6 -left-2 z-0 text-4xl tracking-tight font-bold text-muted-foreground/10 select-none md:-top-10 md:-left-6 md:text-6xl">
						{category.title}
					</div>
					<div class="group/list grid grid-cols-1 gap-8 sm:grid-cols-2 relative z-10">
						{category.projects.map((project) => (
							<ProjectCard
								href={project.href}
								liveHref={project.liveHref}
								repoHref={project.repoHref}
								heading={project.text}
								subheading={project.description}
								icon={project.icon}
								category={category.title}
							/>
						))}
					</div>
				</Section>
			))
		}
	</div>
</BaseLayout>
