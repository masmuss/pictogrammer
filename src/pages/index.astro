---
export const prerender = true;

import { Icon } from "astro-icon/components";
import About from "@/components/features/home/About.astro";
import FeaturedProjects from "@/components/features/home/FeaturedProjects.astro";
import Hero from "@/components/features/home/Hero.astro";
import LatestPosts from "@/components/features/home/LatestPosts.astro";
import Button from "@/components/ui/Button.astro";
import Section from "@/components/ui/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts, getFeaturedProjects } from "@/lib/contents";

const MAX_POSTS = 5;
const MAX_FEATURED_PROJECTS = 5;

const allPosts = await getAllPosts(MAX_POSTS);
const featuredProjects = await getFeaturedProjects(MAX_FEATURED_PROJECTS);

const ctaLinks = [
	{ href: "/about", label: "About me" },
	{ href: "/projects", label: "Projects" },
	{ href: "/blog", label: "Blog" }
];
---

<BaseLayout
  title="Home of Khoirul Fattah"
  description="Explore the personal website of Khoirul Fattah: full-stack projects, technical writing, reflective stories, and practical notes on building better software."
  pageType="website"
>
  <div class="flex w-full flex-col">
    <Section
      title="Ahmad Musafir Khoirul Fattah"
      titleAs="h1"
      titleSize="2xl"
      titleWeight="semibold"
      transitionDelay={0}
      class="pt-0"
      data-testid="hero-section"
    >
      <Hero />
    </Section>

    <Section
      title="About"
      titleAs="h2"
      transitionDelay={150}
      data-testid="about-section"
    >
      <About />
    </Section>

    <Section
      title="Featured Projects"
      titleAs="h2"
      transitionDelay={250}
      data-testid="featured-projects-section"
    >
      <FeaturedProjects projects={featuredProjects} />
    </Section>

    <Section
      title="Latest Posts"
      titleAs="h2"
      transitionDelay={350}
      data-testid="latest-posts-section"
    >
      <LatestPosts posts={allPosts} />
    </Section>

    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-3 pt-12"
      data-testid="home-cta"
    >
      {
        ctaLinks.map((link) => (
          <Button as="a" href={link.href} variant="ghost" class="group/cta px-0">
            {link.label}
            <Icon
              name="ph:arrow-right"
              class="transition-transform duration-base group-hover/cta:translate-x-1"
              aria-hidden="true"
            />
          </Button>
        ))
      }
    </div>
  </div>
</BaseLayout>
