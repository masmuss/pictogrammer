---
export const prerender = true;

import PageHeader from "@/components/common/PageHeader.astro";
import Section from "@/components/common/Section.astro";
import BookItem from "@/components/features/reading/BookItem.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllBooks } from "@/lib/contents/reading";

const books = await getAllBooks();

type Book = Awaited<ReturnType<typeof getAllBooks>>[number];
type BookStatus = Book["status"];

const byStatus = (status: BookStatus) =>
	books.filter((book) => book.status === status);

const sections = [
	{
		books: byStatus("reading"),
		title: "Currently Reading",
		titleSize: "xl" as const,
		transitionDelay: 0,
		class: "max-w-4xl",
		gridClass: "grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4"
	},
	{
		books: byStatus("read"),
		title: "Read",
		titleSize: "base" as const,
		transitionDelay: 150,
		class: "max-w-3xl",
		gridClass: "grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
	},
	{
		books: byStatus("want-to-read"),
		title: "Want to Read",
		titleSize: "base" as const,
		transitionDelay: 300,
		class: "max-w-3xl",
		gridClass: "grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
	}
].filter((section) => section.books.length > 0);
---

<BaseLayout
	title="Reading List"
	description="Books I've read, currently reading, or want to read."
	image={{ src: "/og/reading-list.png", alt: "Reading List - pictogrammmer" }}
	pageType="website"
	breadcrumbs={[
		{ name: "Home", item: new URL("/", Astro.site).href },
		{ name: "Reading List", item: new URL("/reading-list", Astro.site).href }
	]}
>
	<div class="flex w-full flex-col gap-y-12">
		<PageHeader
			title="Reading List"
			description="A collection of books that have shaped my thinking, or ones I'm just curious about."
			as="h1"
		/>

		{
			sections.map((section) => (
				<Section
					title={`${section.title} (${section.books.length})`}
					titleAs="h2"
					titleSize={section.titleSize}
					transitionDelay={section.transitionDelay}
					class={section.class}
				>
					<div class={section.gridClass}>
						{section.books.map((book) => (
							<BookItem book={book} />
						))}
					</div>
				</Section>
			))
		}
	</div>
</BaseLayout>
