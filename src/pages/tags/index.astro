---
export const prerender = true;

import PageHeader from "@/components/common/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/lib/contents";

const allPosts = await getAllPosts();
const sortedTags = getUniqueTagsWithCount(allPosts);
---

<BaseLayout
	title="All Blog Tags and Topics"
	description="Browse every topic tag used across the blog to quickly find posts about Astro, Go, software engineering, personal growth, and reflective writing themes."
	image={{ src: "/og/tags.png", alt: "All Tags - pictogrammmer" }}
	breadcrumbs={[
		{ name: "Home", item: new URL("/", Astro.site).href },
		{ name: "Tags", item: new URL("/tags", Astro.site).href }
	]}
>
	<div class="flex w-full flex-col gap-y-12">
		<PageHeader
			title="Tags"
			description="A list of all the topics I've written about in my posts."
			as="h1"
			class="mb-0"
		/>

		<div class="flex max-w-3xl flex-col">
			<p class="text-muted-foreground">
				{sortedTags.length} tags across {allPosts.length} posts
			</p>
		</div>

		{
			sortedTags.length === 0 && (
				<p class="text-muted-foreground">No posts yet.</p>
			)
		}

		{
			sortedTags.length > 0 && (
				<ul class="flex max-w-3xl flex-col divide-y divide-border/60">
					{sortedTags.map(([tag, count]) => (
						<li>
							<a
								href={`/tags/${tag}`}
								title={`View ${count} post${count > 1 ? "s" : ""} tagged with "${tag}"`}
								class="flex min-h-12 items-center justify-between gap-4 py-3 text-sm transition-colors hover:text-accent-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
								data-astro-prefetch
							>
								<span class="font-medium">#{tag}</span>
								<span class="text-muted-foreground font-mono text-xs tabular-nums">
									{count} {count === 1 ? "post" : "posts"}
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</BaseLayout>
