---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type CardOverlayVariant = "default" | "glass";

interface Props extends HTMLAttributes<"div"> {
	variant?: CardOverlayVariant;
	class?: string;
}

const {
	class: className = "",
	variant = "default",
	...rest
} = Astro.props as Props;
---

<div
	{...rest}
	data-slot="card-overlay"
	class={cn(
		"",
		"absolute inset-0 z-10 p-6 opacity-0 transition-opacity duration-300 ease-out group-hover/card:opacity-100",
		variant === "glass"
			? "bg-background/80 text-foreground backdrop-blur-xs"
			: "bg-background/95 text-foreground",
		className
	)}
>
	<slot />
</div>
