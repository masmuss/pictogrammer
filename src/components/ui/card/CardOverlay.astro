---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/tailwind";

type CardOverlayVariant = "default" | "glass";

interface Props extends HTMLAttributes<"div"> {
	variant?: CardOverlayVariant;
	class?: string;
}

const {
	class: className = "",
	variant = "default",
	...rest
} = Astro.props as Props;
---

<div
	{...rest}
	data-slot="card-overlay"
	class={cn(
		"",
		"inset-0 absolute z-10 opacity-0 p-6 group-hover/card:opacity-100 transition-opacity duration-300 ease-out",
		variant === "glass"
			? "bg-background/80 backdrop-blur-xs text-foreground"
			: "bg-background/95 text-foreground",
		className
	)}
>
	<slot />
</div>
