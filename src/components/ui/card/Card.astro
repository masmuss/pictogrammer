---
import { cn } from "@/lib/utils";

type Props = {
	as?: keyof HTMLElementTagNameMap;
	class?: string;
	href?: string;
	reload?: boolean;
	[key: string]: unknown;
};

const {
	as: Tag = "div",
	class: className,
	href,
	reload = false,
	...attrs
}: Props = Astro.props;

const isAnchor = Tag === "a";
const baseStyles =
	"block bg-card text-card-foreground ring-1 ring-border rounded-lg p-4 transition-colors duration-base";
---

{
	isAnchor ? (
		<a
			{...attrs}
			href={href}
			data-astro-reload={reload ? true : undefined}
			data-slot="card"
			class={cn(baseStyles, className)}
		>
			<slot />
		</a>
	) : (
		<Tag {...attrs} data-slot="card" class={cn(baseStyles, className)}>
			<slot />
		</Tag>
	)
}
