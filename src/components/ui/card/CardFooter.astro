---
import { cn } from "@/lib/utils";
import Box from "../primitives/Box.astro";

interface Props {
	class?: string;
}

const { class: className }: Props = Astro.props;
---

<Box
	data-slot="card-footer"
	display="flex"
	flexDirection="row"
	alignItems="center"
	gap="md"
	padding="md"
	class={cn("rounded-b-xl group-data-[size=sm]/card:p-3", className)}
>
	<slot />
</Box>
