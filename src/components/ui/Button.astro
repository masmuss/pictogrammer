---
import { cn } from "@/lib/utils";

type Props = {
	as?: "a" | "button";
	class?: string;
	title?: string;
	href?: string;
	/** Button visual style */
	variant?:
		"default" | "outline" | "secondary" | "ghost" | "destructive" | "link";
	/** Button size */
	size?:
		"default" | "xs" | "sm" | "lg" | "icon" | "icon-xs" | "icon-sm" | "icon-lg";
	/** Legacy prop - use variant instead */
	style?: "button" | "pill" | "tab";
	/** Disable button interaction */
	disabled?: boolean;
	/** Show loading state */
	loading?: boolean;
	/** Accessible label (required for icon-only buttons) */
	"aria-label"?: string;
	[key: string]: unknown;
};

const {
	as = "a",
	class: className,
	title,
	href,
	variant,
	size = "default",
	style,
	disabled = false,
	loading = false,
	...attrs
}: Props = Astro.props;

const baseClasses = {
	layout: "group/button inline-flex shrink-0 items-center justify-center",
	shape: "rounded-md ring-1 ring-inset ring-transparent bg-clip-padding",
	text: "text-sm font-medium whitespace-nowrap",
	transition: "transition-all duration-fast ease-out outline-none select-none",
	focus: "focus-visible:ring-3 focus-visible:ring-ring/50",
	active: "active:not-aria-[haspopup]:scale-[0.98]",
	disabled: "disabled:pointer-events-none disabled:opacity-50",
	validation:
		"aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40",
	icon: "[&_svg]:pointer-events-none [&_svg]:shrink-0",
};

const baseClass = Object.values(baseClasses).join(" ");

const variantClass: Record<NonNullable<Props["variant"]>, string> = {
	default:
		"bg-btn-primary text-btn-primary-foreground hover:bg-btn-primary/85 shadow-2xs",
	outline:
		"ring-1 ring-inset ring-border bg-background hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground shadow-2xs",
	secondary:
		"bg-secondary text-secondary-foreground hover:bg-secondary/80 aria-expanded:bg-secondary aria-expanded:text-secondary-foreground",
	ghost:
		"hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50",
	destructive:
		"bg-destructive/10 text-destructive hover:bg-destructive/20 focus-visible:border-destructive/40 focus-visible:ring-destructive/20 dark:bg-destructive/20 dark:hover:bg-destructive/30 dark:focus-visible:ring-destructive/40",
	link: "text-primary underline-offset-4 hover:underline",
};

const sizeClass: Record<NonNullable<Props["size"]>, string> = {
	default:
		"h-8 gap-1.5 px-3 has-data-[icon=inline-end]:pr-2.5 has-data-[icon=inline-start]:pl-2.5",
	xs: "h-6 gap-1 rounded-sm px-2 text-xs in-data-[slot=button-group]:rounded-sm has-data-[icon=inline-end]:pr-1.5 has-data-[icon=inline-start]:pl-1.5",
	sm: "h-7 gap-1 rounded-md px-2.5 text-[0.8rem] in-data-[slot=button-group]:rounded-md has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2",
	lg: "h-10 gap-2 px-4 text-base has-data-[icon=inline-end]:pr-3 has-data-[icon=inline-start]:pl-3",
	icon: "size-8",
	"icon-xs": "size-6 rounded-sm in-data-[slot=button-group]:rounded-sm",
	"icon-sm": "size-7 rounded-md in-data-[slot=button-group]:rounded-md",
	"icon-lg": "size-10",
};

const legacyVariantMap: Record<
	NonNullable<Props["style"]>,
	NonNullable<Props["variant"]>
> = {
	button: "outline",
	pill: "outline",
	tab: "ghost",
};

const resolvedVariant =
	variant ?? (style ? legacyVariantMap[style] : "default");
const resolvedSize = size;
const legacyClass = cn(
	style === "pill" && "rounded-md",
	style === "tab" &&
		"rounded-md text-muted-foreground ring-1 ring-border/60 ring-inset hover:text-foreground data-[active=true]:bg-primary/10 data-[active=true]:text-foreground data-[active=true]:ring-primary/40",
);

const isButton = as === "button";
const hasStartIcon = Astro.slots.has("icon-before");
const hasEndIcon = Astro.slots.has("icon-after");
const hasDefaultSlot = Astro.slots.has("default");
const shouldPrefetch = Boolean(href && !isButton && href.startsWith("/"));
const prefetchProps = shouldPrefetch
	? { "data-astro-prefetch": true as const }
	: {};
---

{
	isButton ? (
		<button
			type="button"
			data-slot="button"
			data-variant={resolvedVariant}
			data-size={resolvedSize}
			disabled={disabled || loading}
			aria-disabled={disabled || loading}
			aria-busy={loading}
			{...attrs}
			class={cn(
				baseClass,
				variantClass[resolvedVariant],
				sizeClass[resolvedSize],
				legacyClass,
				"leading-none",
				className,
			)}
		>
			{hasStartIcon && (
				<span
					data-icon="inline-start"
					class="inline-flex items-center justify-center leading-none"
				>
					<slot name="icon-before" />
				</span>
			)}
			{title ? (
				<span class="leading-none">{title}</span>
			) : (
				hasDefaultSlot && <slot />
			)}
			{hasEndIcon && (
				<span
					data-icon="inline-end"
					class="inline-flex items-center justify-center leading-none"
				>
					<slot name="icon-after" />
				</span>
			)}
		</button>
	) : (
		<a
			data-slot="button"
			data-variant={resolvedVariant}
			data-size={resolvedSize}
			aria-disabled={disabled || loading}
			{...prefetchProps}
			href={disabled || loading ? undefined : href}
			{...attrs}
			class={cn(
				baseClass,
				variantClass[resolvedVariant],
				sizeClass[resolvedSize],
				legacyClass,
				"leading-none",
				(disabled || loading) && "pointer-events-none opacity-50",
				className,
			)}
		>
			{hasStartIcon && (
				<span
					data-icon="inline-start"
					class="inline-flex items-center justify-center leading-none"
				>
					<slot name="icon-before" />
				</span>
			)}
			{title ? (
				<span class="leading-none">{title}</span>
			) : (
				hasDefaultSlot && <slot />
			)}
			{hasEndIcon && (
				<span
					data-icon="inline-end"
					class="inline-flex items-center justify-center leading-none"
				>
					<slot name="icon-after" />
				</span>
			)}
		</a>
	)
}
