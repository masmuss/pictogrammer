---
import Stack from "./primitives/Stack.astro";
import Text from "./primitives/Text.astro";

interface Props {
	title: string;
	description?: string;
	as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	class?: string;
}

const {
	title,
	description,
	as = "h1",
	class: className = ""
}: Props = Astro.props;
---

<Stack gap="xs" class={className}>
	<Text as={as} size="xl" weight="semibold">{title}</Text>
	{
		description && (
			<Text size="base" color="muted">
				{description}
			</Text>
		)
	}
</Stack>
