---
/**
 * Heading - Semantic heading component (backward compatibility wrapper)
 *
 * Re-exports Text component for backward compatibility.
 * New code should use: <Text as="h1" size="2xl" weight="semibold">
 *
 * @deprecated Use Text component with heading tags instead
 * @example
 * ```astro
 * // Old way (still works, but deprecated)
 * <Heading as="h2" size="2xl" weight="semibold">Title</Heading>
 *
 * // New way (preferred)
 * <Text as="h2" size="2xl" weight="semibold">Title</Text>
 * ```
 */

import Text from "./primitives/Text.astro";

interface Props {
	as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	size?:
		"xs" | "sm" | "base" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl";
	weight?: "light" | "regular" | "medium" | "semibold" | "bold";
	color?: "default" | "muted" | "subtle" | "accent";
	class?: string;
}

const {
	as = "h2",
	size = "base",
	weight = "medium",
	color = "default",
	class: className,
}: Props = Astro.props;
---

<Text as={as} size={size} weight={weight} color={color} class={className}>
	<slot />
</Text>
