---
import { cn } from "@/lib/utils";

/**
 * Badge component for displaying tags, labels, and status indicators
 *
 * @example
 * ```astro
 * <Badge variant="default">Tag</Badge>
 * <Badge variant="accent">Featured</Badge>
 * <Badge as="a" href="/tags/astro">Astro</Badge>
 * ```
 */

type Variant =
	| "default"
	| "secondary"
	| "accent"
	| "destructive"
	| "outline"
	| "muted"
	| "link";

interface Props {
	/** Visual style variant */
	variant?: Variant;
	/** Badge size */
	size?: "sm" | "default" | "lg";
	/** HTML element to render as */
	as?: keyof HTMLElementTagNameMap;
	/** Additional CSS classes */
	class?: string;
	/** Link href (when used as anchor) */
	href?: string;
	[key: string]: unknown;
}

const {
	variant = "default",
	size = "default",
	as: Tag = "span",
	class: className,
	href,
	...attrs
} = Astro.props as Props;

const base = [
	"inline-flex w-fit shrink-0 items-center justify-center gap-1",
	"overflow-hidden rounded-full ring-1 ring-inset ring-transparent",
	"font-medium whitespace-nowrap",
	"transition-colors duration-fast ease-default",
	"focus-visible:ring-[3px] focus-visible:ring-ring/50",
	"aria-invalid:ring-destructive/20",
	"dark:aria-invalid:ring-destructive/40",
	"[&>svg]:pointer-events-none [&>svg]:shrink-0"
].join(" ");

const sizes: Record<Exclude<Props["size"], undefined>, string> = {
	sm: "px-1.5 py-0.5 text-[10px] [&>svg]:size-2.5",
	default: "px-2 py-0.5 text-xs [&>svg]:size-3",
	lg: "px-2.5 py-1 text-sm [&>svg]:size-3.5"
};

/** Variant semantic meaning:
 * - default: Primary badge for main content
 * - secondary: Alternative badge for secondary info
 * - accent: Highlight/featured badge
 * - destructive: Error/alert/dangerous status
 * - outline: Border-only light appearance
 * - muted: Subtle/disabled badge
 * - link: Clickable badge (for navigation)
 */
const variants: Record<Variant, string> = {
	default: "bg-primary text-primary-foreground [a&]:hover:bg-primary/90",
	secondary:
		"bg-secondary text-secondary-foreground [a&]:hover:bg-secondary/90",
	accent: "bg-accent text-accent-foreground [a&]:hover:bg-accent/90",
	destructive:
		"bg-destructive text-white focus-visible:ring-destructive/20 dark:bg-destructive/60 dark:focus-visible:ring-destructive/40 [a&]:hover:bg-destructive/90",
	outline:
		"ring-inset ring-muted-foreground/25 text-foreground [a&]:hover:bg-border/20 [a&]:hover:text-foreground",
	muted:
		"bg-muted text-muted-foreground [a&]:hover:bg-muted/80 [a&]:hover:text-muted-foreground",
	link: "text-primary underline-offset-4 [a&]:hover:underline"
};
---

<Tag
  data-slot="badge"
  data-variant={variant}
  data-size={size}
  href={href}
  class={cn(base, variants[variant], sizes[size], className)}
  {...attrs}
>
  <slot />
</Tag>
