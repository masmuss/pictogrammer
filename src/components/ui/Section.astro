---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import Heading from "./Heading.astro";

interface Props extends HTMLAttributes<"section"> {
	class?: string;
	as?: keyof HTMLElementTagNameMap;
	title?: string;
	titleAs?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	titleSize?:
		| "6xl"
		| "5xl"
		| "4xl"
		| "3xl"
		| "2xl"
		| "xl"
		| "lg"
		| "base"
		| "sm";
	titleWeight?: "bold" | "semibold" | "medium" | "light";
	titleUppercase?: boolean;
	transitionDelay?: number;
}

const {
	class: className,
	as: SectionTag = "section",
	title,
	titleAs = "h2",
	titleSize = "base",
	titleWeight = "medium",
	titleUppercase = false,
	transitionDelay = 0,
	...attrs
}: Props = Astro.props;
---

<SectionTag
  data-fade-up="true"
  class={cn(
    className,
    "flex flex-col gap-y-4",
    "opacity-0 translate-y-4 transition-all ease-out",
    "data-[fade-up=true]:opacity-100 data-[fade-up=true]:translate-y-0",
  )}
  style={transitionDelay > 0
    ? {
        transitionDuration: "var(--duration-slower)",
        transitionDelay: `${transitionDelay}ms`,
      }
    : { transitionDuration: "var(--duration-slower)" }}
  {...attrs}
>
  {
    title && (
      <Heading
        as={titleAs}
        size={titleSize}
        weight={titleUppercase ? "semibold" : titleWeight}
        class={cn(
          titleUppercase
            ? "text-muted-foreground text-[0.8rem] tracking-widest uppercase"
            : "text-foreground tracking-tight",
        )}
      >
        {title}
      </Heading>
    )
  }
  <div class="flex flex-col gap-y-3">
    <slot />
  </div>
</SectionTag>

<script>
  function observeFadeUp() {
    if (document.readyState !== "loading") {
      setupObserver();
    } else {
      document.addEventListener("DOMContentLoaded", setupObserver);
    }
  }

  function setupObserver() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-4");
            entry.target.classList.add("opacity-100", "translate-y-0");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: "0px",
        threshold: 0.1,
      },
    );

    // Only observe elements with data-fade-up attribute
    document.querySelectorAll('[data-fade-up="true"]').forEach((element) => {
      observer.observe(element);
    });
  }

  // Initial setup
  observeFadeUp();

  // Handle Astro ViewTransitions
  document.addEventListener("astro:page-load", observeFadeUp);
</script>
