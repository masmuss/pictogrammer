---
import Button from "@/components/ui/Button.astro";
import siteConfig from "@/config/site-config";
import { getCurrentRole } from "@/lib/contents";
import MobileMenuStatus from "./MobileMenuStatus.astro";

const { navLinks } = siteConfig.header;
const { socialLinks, email } = siteConfig;

const githubLink = socialLinks.find((l) => l.text === "GitHub");
const linkedinLink = socialLinks.find((l) => l.text === "LinkedIn");
const instagramLink = socialLinks.find((l) => l.text === "Instagram");

const currentRole = await getCurrentRole();
---

<mobile-menu class="lg:hidden">
	<Button
		as="button"
		variant="ghost"
		size="icon-sm"
		id="menu-toggle"
		aria-label="Open navigation menu"
		aria-expanded="false"
		aria-controls="mobile-nav"
	>
		<span class="iconify ri--menu-line" aria-hidden="true"></span>
	</Button>

	<div
		id="mobile-nav"
		class="bg-secondary/70 pointer-events-none fixed inset-0 z-50 translate-x-full overflow-y-auto p-6 opacity-0 backdrop-blur-2xl transition-[opacity,transform] duration-300 ease-out"
		role="dialog"
		aria-modal="true"
		aria-label="Navigation menu"
		inert
	>
		<div class="bg-background flex flex-1 flex-col rounded-xl">
			<!-- Mobile Header -->
			<div
				class="bg-background/90 sticky top-0 z-50 flex items-center justify-between rounded-t-xl p-6 backdrop-blur-sm transition delay-75 duration-300"
			>
				<a href="/" class="text-2xl font-semibold">pictogrammer</a>
				<Button
					variant="ghost"
					size="icon-lg"
					type="button"
					id="menu-close"
					aria-label="Close navigation menu"
				>
					<span class="iconify ri--close-line" aria-hidden="true"></span>
				</Button>
			</div>

			<div class="flex flex-1 flex-col justify-between space-y-8 px-6 py-8">
				<nav class="flex flex-col divide-y" aria-label="mobile navigation">
					{
						navLinks.map((link, i) => (
							<a
								href={link.href}
								class="group hover:text-accent-cta-text translate-y-4 py-4 text-xl font-semibold tracking-tight opacity-0 transition-all duration-300 ease-out"
								style={`transition-delay: ${150 + i * 75}ms`}
							>
								<span class="bg-flexoki-orange-400 h-6 w-6 shrink-0 opacity-0 transition-opacity group-hover:opacity-100" />
								{link.text}
							</a>
						))
					}
				</nav>

				<!-- Extra Sections -->
				<div class="grid grid-cols-1 gap-12 sm:grid-cols-2">
					<!-- Contact -->
					<div class="flex flex-col gap-y-4">
						<h3
							class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
						>
							Contact
						</h3>
						<div class="flex flex-col gap-y-2 text-sm">
							<a
								href={`mailto:${email}`}
								class="hover:text-accent-cta-text transition-colors"
							>
								{email}
							</a>
						</div>
					</div>

					<!-- Socials -->
					<div class="flex flex-col gap-y-4">
						<h3
							class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
						>
							Connect
						</h3>
						<div class="flex flex-col gap-y-2 text-sm">
							{
								instagramLink && (
									<a
										href={instagramLink.href}
										target="_blank"
										rel="noopener"
										class="hover:text-accent-cta-text transition-colors"
									>
										Instagram
									</a>
								)
							}
							{
								linkedinLink && (
									<a
										href={linkedinLink.href}
										target="_blank"
										rel="noopener"
										class="hover:text-accent-cta-text transition-colors"
									>
										LinkedIn
									</a>
								)
							}
							{
								githubLink && (
									<a
										href={githubLink.href}
										target="_blank"
										rel="noopener"
										class="hover:text-accent-cta-text transition-colors"
									>
										GitHub
									</a>
								)
							}
						</div>
					</div>
				</div>

				<!-- Status -->
				<div class="border-border/50 flex flex-col gap-y-6 border-t pt-8">
					<p
						class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
					>
						Status
					</p>
					<div class="flex flex-col gap-y-4">
						<MobileMenuStatus
							status={currentRole == null ? (
								<span>Accepting new projects</span>
							) : (
								<span>
									{currentRole.title} at {currentRole.company}
								</span>
							)}
						/>
						<MobileMenuStatus status="Surabaya, Indonesia (UTC+7)" />
					</div>
				</div>
			</div>
		</div>
	</div>
</mobile-menu>

<script>
	class MobileMenu extends HTMLElement {
		constructor() {
			super();
			const toggle = this.querySelector<HTMLButtonElement>("#menu-toggle");
			const closeBtn = this.querySelector<HTMLButtonElement>("#menu-close");
			const nav = this.querySelector<HTMLDivElement>("#mobile-nav");

			if (!toggle || !nav || !closeBtn) return;

			let isOpen = false;

			const animateLinks = nav.querySelectorAll<HTMLAnchorElement>("nav a");

			const setOpen = (open: boolean) => {
				isOpen = open;
				toggle.setAttribute("aria-expanded", String(open));
				if (open) {
					nav.classList.remove(
						"translate-x-full",
						"opacity-0",
						"pointer-events-none"
					);
					nav.classList.add(
						"translate-x-0",
						"opacity-100",
						"pointer-events-auto"
					);
					nav.removeAttribute("inert");
					animateLinks.forEach((link) => {
						link.classList.remove("translate-y-4", "opacity-0");
						link.classList.add("translate-y-0", "opacity-100");
					});
				} else {
					nav.classList.remove(
						"translate-x-0",
						"opacity-100",
						"pointer-events-auto"
					);
					nav.classList.add(
						"translate-x-full",
						"opacity-0",
						"pointer-events-none"
					);
					nav.setAttribute("inert", "");
					animateLinks.forEach((link) => {
						link.classList.remove("translate-y-0", "opacity-100");
						link.classList.add("translate-y-4", "opacity-0");
					});
				}
				document.body.style.overflow = open ? "hidden" : "";
			};

			const close = () => setOpen(false);

			toggle.addEventListener("click", () => setOpen(true));
			closeBtn.addEventListener("click", () => setOpen(false));

			// Close when clicking overlay background (not content)
			nav.addEventListener("click", (e) => {
				if (e.target === nav) setOpen(false);
			});

			nav.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", close);
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && isOpen) close();
			});

			document.addEventListener("astro:after-swap", close);
		}
	}

	if (!customElements.get("mobile-menu")) {
		customElements.define("mobile-menu", MobileMenu);
	}
</script>
