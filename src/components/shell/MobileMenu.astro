---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/button/Button.astro";
import siteConfig from "@/config/site";
import { getCurrentRole } from "@/lib/contents";
import MobileMenuExtras from "./MobileMenuExtras.astro";
import MobileMenuLinks from "./MobileMenuLinks.astro";

const { navLinks } = Astro.props;
const { email } = siteConfig;

const currentRole = await getCurrentRole();
const isActive = Astro.url.pathname;
---

<mobile-menu class="lg:hidden">
	<Button
		as="button"
		variant="ghost"
		size="icon"
		id="menu-toggle"
		aria-label="Open navigation menu"
		aria-expanded="false"
		aria-controls="mobile-nav"
	>
		<Icon name="ph:list" aria-hidden="true" />
	</Button>

	<div
		id="mobile-nav"
		class="bg-background duration-slow pointer-events-none fixed inset-0 z-50 flex flex-1 translate-x-full flex-col overflow-y-auto p-8 transition-all ease-out will-change-transform"
		role="dialog"
		aria-modal="true"
		aria-label="Navigation menu"
		inert
	>
		<!-- Mobile Header -->
		<div class="bg-background/90 duration-slow flex items-center justify-between backdrop-blur-sm transition delay-75">
			<a href="/" class="text-xl font-semibold">
				pictogrammer
			</a>
			<Button
				as="button"
				variant="ghost"
				size="icon-lg"
				type="button"
				id="menu-close"
				aria-label="Close navigation menu"
				class="sticky top-0 z-50"
			>
				<Icon name="ph:x" aria-hidden="true" />
			</Button>
		</div>

		<div class="flex flex-1 flex-col justify-between space-y-8 py-8">
			<MobileMenuLinks links={navLinks} currentPath={isActive} />
			<MobileMenuExtras {email} {currentRole} />
		</div>
	</div>
</mobile-menu>

<script>
	class MobileMenu extends HTMLElement {
		constructor() {
			super();
			const toggle = this.querySelector<HTMLButtonElement>("#menu-toggle");
			const closeBtn = this.querySelector<HTMLButtonElement>("#menu-close");
			const nav = this.querySelector<HTMLDivElement>("#mobile-nav");

			if (!toggle || !nav || !closeBtn) return;

			let isOpen = false;
			let resetTimer: ReturnType<typeof setTimeout> | null = null;

			const animateLinks = nav.querySelectorAll<HTMLAnchorElement>("nav a");
			const animateSections = nav.querySelectorAll<HTMLElement>(
				"[data-mobile-entrance]"
			);

			const setOpen = (open: boolean) => {
				// Cancel pending entrance reset from previous close
				if (resetTimer !== null) {
					clearTimeout(resetTimer);
					resetTimer = null;
				}

				isOpen = open;
				toggle.setAttribute("aria-expanded", String(open));
				if (open) {
					nav.classList.remove(
						"translate-x-full",
						"opacity-0",
						"pointer-events-none"
					);
					nav.classList.add(
						"translate-x-0",
						"opacity-100",
						"pointer-events-auto"
					);
					nav.removeAttribute("inert");
					animateLinks.forEach((link) => {
						link.classList.remove("translate-y-4", "opacity-0");
						link.classList.add("translate-y-0", "opacity-100");
					});
					animateSections.forEach((el) => {
						el.classList.remove("translate-y-4", "opacity-0");
						el.classList.add("translate-y-0", "opacity-100");
					});
				} else {
					nav.classList.remove(
						"translate-x-0",
						"opacity-100",
						"pointer-events-auto"
					);
					nav.classList.add(
						"translate-x-full",
						"opacity-0",
						"pointer-events-none"
					);
					nav.setAttribute("inert", "");
					resetTimer = setTimeout(() => {
						animateLinks.forEach((link) => {
							link.classList.add("translate-y-4", "opacity-0");
							link.classList.remove("translate-y-0", "opacity-100");
						});
						animateSections.forEach((el) => {
							el.classList.add("translate-y-4", "opacity-0");
							el.classList.remove("translate-y-0", "opacity-100");
						});
						resetTimer = null;
					}, 300);
				}
				document.body.style.overflow = open ? "hidden" : "";
			};

			const close = () => setOpen(false);

			toggle.addEventListener("click", () => setOpen(true));
			closeBtn.addEventListener("click", () => setOpen(false));

			// Close when clicking overlay background (not content)
			nav.addEventListener("click", (e) => {
				if (e.target === nav) setOpen(false);
			});

			nav.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", (e) => {
					const href = link.getAttribute("href");
					const isExternal =
						link.getAttribute("target") === "_blank" ||
						(href && (href.startsWith("http") || href.startsWith("mailto")));
					if (!isExternal) {
						e.preventDefault();
						close();
						setTimeout(() => {
							if (href) window.location.href = href;
						}, 300);
					} else {
						close();
					}
				});
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && isOpen) close();
			});

			document.addEventListener("astro:after-swap", close);
		}
	}

	if (!customElements.get("mobile-menu")) {
		customElements.define("mobile-menu", MobileMenu);
	}
</script>
