---
import Button from "@/components/ui/Button.astro";
import siteConfig from "@/config/site-config";

const { navLinks } = siteConfig.header;
const { socialLinks, email } = siteConfig;

const githubLink = socialLinks.find((l) => l.text === "GitHub");
const linkedinLink = socialLinks.find((l) => l.text === "LinkedIn");
const instagramLink = socialLinks.find((l) => l.text === "Instagram");
---

<mobile-menu class="lg:hidden">
	<Button
		as="button"
		variant="ghost"
		size="icon-sm"
		id="menu-toggle"
		aria-label="Open navigation menu"
		aria-expanded="false"
		aria-controls="mobile-nav"
	>
		<span class="iconify ri--menu-line" aria-hidden="true"></span>
	</Button>

	<div
		id="mobile-nav"
		class="bg-background fixed inset-0 z-50 hidden flex-col overflow-y-auto"
		role="dialog"
		aria-modal="true"
		aria-label="Navigation menu"
	>
		<!-- Mobile Header -->
		<div
			class="bg-background/90 sticky top-0 z-50 flex items-center justify-between p-8 backdrop-blur-sm"
		>
			<a href="/" class="text-2xl font-semibold">pictogrammer</a>
			<Button
				variant="ghost"
				size="icon-lg"
				type="button"
				id="menu-close"
				aria-label="Close navigation menu"
			>
				<span class="iconify ri--close-line" aria-hidden="true"></span>
			</Button>
		</div>

		<div class="flex flex-1 flex-col justify-between px-8 py-12">
			<nav class="flex flex-col divide-y" aria-label="mobile navigation">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class="group hover:text-accent-cta-text py-4 text-xl font-semibold tracking-tight transition-colors"
						>
							<span class="bg-flexoki-orange-400 h-6 w-6 shrink-0 opacity-0 transition-opacity group-hover:opacity-100" />
							{link.text}
						</a>
					))
				}
			</nav>

			<!-- Extra Sections -->
			<div class="grid grid-cols-1 gap-12 sm:grid-cols-2">
				<!-- Contact -->
				<div class="flex flex-col gap-y-4">
					<h3
						class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
					>
						Contact
					</h3>
					<div class="flex flex-col gap-y-2 text-sm">
						<a
							href={`mailto:${email}`}
							class="hover:text-accent-cta-text transition-colors"
						>
							{email}
						</a>
					</div>
				</div>

				<!-- Socials -->
				<div class="flex flex-col gap-y-4">
					<h3
						class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
					>
						Connect
					</h3>
					<div class="flex flex-col gap-y-2 text-sm">
						{
							instagramLink && (
								<a
									href={instagramLink.href}
									target="_blank"
									rel="noopener"
									class="hover:text-accent-cta-text transition-colors"
								>
									Instagram
								</a>
							)
						}
						{
							linkedinLink && (
								<a
									href={linkedinLink.href}
									target="_blank"
									rel="noopener"
									class="hover:text-accent-cta-text transition-colors"
								>
									LinkedIn
								</a>
							)
						}
						{
							githubLink && (
								<a
									href={githubLink.href}
									target="_blank"
									rel="noopener"
									class="hover:text-accent-cta-text transition-colors"
								>
									GitHub
								</a>
							)
						}
					</div>
				</div>
			</div>

			<!-- Status -->
			<div class="border-border/50 mt-20 flex flex-col gap-y-6 border-t pt-10">
				<p
					class="text-muted-foreground text-xs font-bold tracking-widest uppercase"
				>
					Status
				</p>
				<div class="flex flex-col gap-y-4">
					<div
						class="flex items-center gap-x-3 text-xs font-medium tracking-tight uppercase"
					>
						<span class="bg-flexoki-orange-400 h-3 w-3 shrink-0"></span>
						Accepting new projects
					</div>
					<div
						class="flex items-center gap-x-3 text-xs font-medium tracking-tight uppercase"
					>
						<span class="bg-flexoki-orange-400 h-3 w-3 shrink-0"></span>
						Surabaya, Indonesia (UTC+7)
					</div>
				</div>
			</div>
		</div>
	</div>
</mobile-menu>

<script>
	class MobileMenu extends HTMLElement {
		constructor() {
			super();
			const toggle = this.querySelector<HTMLButtonElement>("#menu-toggle");
			const closeBtn = this.querySelector<HTMLButtonElement>("#menu-close");
			const nav = this.querySelector<HTMLDivElement>("#mobile-nav");

			if (!toggle || !nav || !closeBtn) return;

			let isOpen = false;

			const setOpen = (open: boolean) => {
				isOpen = open;
				toggle.setAttribute("aria-expanded", String(open));
				if (open) {
					nav.classList.remove("hidden");
					nav.classList.add("flex");
				} else {
					nav.classList.remove("flex");
					nav.classList.add("hidden");
				}
				document.body.style.overflow = open ? "hidden" : "";
			};

			const close = () => setOpen(false);

			toggle.addEventListener("click", () => setOpen(true));
			closeBtn.addEventListener("click", () => setOpen(false));

			// Close when clicking overlay background (not content)
			nav.addEventListener("click", (e) => {
				if (e.target === nav) setOpen(false);
			});

			nav.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", close);
			});

			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && isOpen) close();
			});

			document.addEventListener("astro:after-swap", close);
		}
	}

	if (!customElements.get("mobile-menu")) {
		customElements.define("mobile-menu", MobileMenu);
	}
</script>
