---
import { Image } from "astro:assets";
import logoDark from "@/assets/images/logo-dark.svg";
import logoLight from "@/assets/images/logo-light.svg";

interface Props {
	class?: string;
	href?: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
}

const {
	class: className = "h-10 w-auto",
	href = "/",
	loading = "lazy",
	fetchpriority = "auto"
} = Astro.props;
---

<a
	href={href}
	class={`inline-flex shrink-0 ${className}`}
	aria-label="pictogrammer"
>
	<Image
		src={logoLight}
		alt="pictogrammer"
		class="h-full w-auto dark:hidden"
		loading={loading}
		fetchpriority={fetchpriority}
	/>
	<Image
		src={logoDark}
		alt="pictogrammer"
		class="hidden h-full w-auto dark:block"
		loading={loading}
		fetchpriority={fetchpriority}
	/>
</a>
