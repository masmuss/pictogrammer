---
import type { Experience } from "@/types";
import SocialLinks from "../common/SocialLinks.astro";
import MobileMenuStatus from "./MobileMenuStatus.astro";

interface Props {
	email: string;
	currentRole?: Experience;
}

const { email, currentRole } = Astro.props;
---

<div class="flex flex-1 flex-col justify-between space-y-8 py-8">
	<div
		class="grid translate-y-4 grid-cols-1 opacity-0 transition-all duration-slow sm:grid-cols-2"
		data-mobile-entrance
		style="transition-delay: 500ms"
	>
		<div class="flex flex-col gap-y-4">
			<h3 class="text-muted-foreground text-xs font-semibold">Contact</h3>
			<div class="flex flex-col gap-y-2 text-sm">
				<a
					href={`mailto:${email}`}
					class="w-fit rounded-sm transition-colors hover:text-accent-cta-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				>
					{email}
				</a>
			</div>
		</div>

		<div class="flex flex-col gap-y-4">
			<h3 class="text-muted-foreground text-xs font-semibold">Connect</h3>
			<SocialLinks class="flex flex-row" />
		</div>
	</div>

	<div
		class="border-border/50 flex translate-y-4 flex-col gap-y-6 border-t pt-8 opacity-0 transition-all duration-slow"
		data-mobile-entrance
		style="transition-delay: 600ms"
	>
		<p class="text-muted-foreground text-xs font-semibold">Status</p>
		<div class="flex flex-col gap-y-4">
			<MobileMenuStatus
				status={
					currentRole ? (
						<span>
							{currentRole.title} at {currentRole.company}
						</span>
					) : (
						<span>Accepting new projects</span>
					)
				}
			/>
			<MobileMenuStatus status="Surabaya, Indonesia (UTC+7)" />
		</div>
	</div>
</div>
