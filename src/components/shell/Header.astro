---
import { Image } from "astro:assets";
import logoDark from "@/assets/images/logo-dark.svg";
import logoLight from "@/assets/images/logo-light.svg";
import NavLink from "@/components/shell/NavLink.astro";
import { Search } from "@/components/ui/search";
import ThemeToggle from "@/components/ui/ThemeToggle.astro";
import siteConfig from "@/config/site-config";

const { navLinks } = siteConfig.header;
---

<header
	class="mb-10 flex w-full flex-wrap py-8 text-sm sm:flex-nowrap sm:justify-start md:py-12"
>
	<nav
		class="relative mx-auto flex w-full items-center justify-between gap-x-3 md:gap-5"
		aria-label="global"
	>
		<a class="flex flex-none" href="/" aria-label="pictogrammer logo">
			<Image
				src={logoLight}
				alt="pictogrammer logo"
				class="w-12 md:w-14 lg:w-16 dark:hidden"
				loading="eager"
				fetchpriority="high"
			/>
			<Image
				src={logoDark}
				alt="pictogrammer logo"
				class="hidden w-12 md:w-14 lg:w-16 dark:block"
				loading="eager"
				fetchpriority="high"
			/>
		</a>

		<div class="ml-auto flex flex-row items-center gap-x-5">
			<!-- Navigation -->
			{
				navLinks.map((link) => (
					<NavLink href={link.href} text={link.text} icon={link.icon} />
				))
			}

			<Search client:load />
			<ThemeToggle />
		</div>
	</nav>
</header>
