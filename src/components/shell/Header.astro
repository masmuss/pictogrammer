---
import { Container } from "@/components/common/primitives";
import Search from "@/components/features/search/Search.astro";
import Logo from "@/components/shell/Logo.astro";
import MobileMenu from "@/components/shell/MobileMenu.astro";
import ThemeToggle from "@/components/shell/ThemeToggle.astro";
import { footerLinks, header } from "@/config/site";

const { textLinks } = header;
---

<header class="w-full text-sm">
	<Container class="relative flex flex-wrap items-center justify-between gap-x-3 py-8 sm:flex-nowrap sm:justify-start md:gap-5">
		<Logo loading="eager" fetchpriority="high" />

		<div class="ml-auto flex flex-row items-center md:gap-x-5">
			<!-- Desktop Navigation -->
			<div class="hidden lg:block">
				<nav aria-label="Primary">
					<ul class="flex items-center gap-1">
						{textLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-muted-foreground hover:text-foreground inline-flex h-9 items-center justify-center rounded-md px-2 text-sm transition-colors"
								>
									{link.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>

			<div class="ml-1 flex items-center gap-1 sm:ml-2 sm:gap-2">
				<Search />
				<ThemeToggle />
				<MobileMenu navLinks={[...textLinks, ...footerLinks]} />
			</div>
		</div>
	</Container>
</header>
