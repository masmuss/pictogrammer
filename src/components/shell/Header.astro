---
import { Icon } from "astro-icon/components";
import { Search } from "@/components/features/search";
import Logo from "@/components/shell/Logo.astro";
import MobileMenu from "@/components/shell/MobileMenu.astro";
import NavLink from "@/components/shell/NavLink.astro";
import ThemeToggle from "@/components/shell/ThemeToggle.astro";
import siteConfig from "@/config/site-config";

const { textLinks, iconLinks } = siteConfig.header;
---

<header
	class="flex w-full flex-wrap p-8 text-sm sm:flex-nowrap sm:justify-start"
>
	<nav
		class="relative mx-auto flex w-full items-center justify-between gap-x-3 md:gap-5"
		aria-label="global"
	>
		<Logo loading="eager" fetchpriority="high" />

		<div class="ml-auto flex flex-row items-center md:gap-x-5">
			<!-- Desktop Navigation -->
			<div class="hidden items-center gap-x-5 lg:flex">
				{textLinks.map((link) => <NavLink href={link.href} text={link.text} />)}
			</div>

			<div class="hidden lg:block w-px h-4 bg-border mx-2"></div>

			<!-- Icons Navigation -->
			<div class="hidden items-center gap-x-4 lg:flex">
				{
					iconLinks.map((link) => (
						<a
							href={link.href}
							title={link.text}
							class="text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-sm"
							target={link.href.startsWith("http") ? "_blank" : "_self"}
							rel={link.href.startsWith("http") ? "noopener noreferrer" : ""}
						>
							<span class="sr-only">{link.text}</span>
							<Icon name={link.icon} class="w-5 h-5" />
						</a>
					))
				}
			</div>

			<div class="flex items-center gap-1 sm:gap-2 ml-1 sm:ml-2">
				<Search client:load />
				<ThemeToggle />
				<MobileMenu
					navLinks={[
						...textLinks,
						...iconLinks.filter((link) => link.href.startsWith("/"))
					]}
				/>
			</div>
		</div>
	</nav>
</header>
