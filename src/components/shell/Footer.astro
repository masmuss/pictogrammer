---
import Logo from "@/components/shell/Logo.astro";
import { Container } from "@/components/ui/primitives";
import siteConfig from "@/config/site-config";
import FooterLinkGroup from "./FooterLinkGroup.astro";

const navigationLinks = [
	...siteConfig.header.navLinks.slice(1, 5),
	{ href: "/rss.xml", text: "RSS" }
];
const legalLink = [{ href: "/legal", text: "Legal" }];
---

<footer class="border-border/50 bg-card/70 mt-20 border-t">
  <Container class="flex flex-col gap-4 pt-12 pb-8 text-sm md:pt-16">
    <div class="grid grid-cols-1 gap-10 pb-12 md:grid-cols-[3fr_1fr_1fr_1fr]">
      <div class="space-y-4">
        <Logo />
        <p class="text-muted-foreground leading-relaxed">
          {siteConfig.subtitle}
        </p>
      </div>

      <FooterLinkGroup title="Navigate" pageLinks={navigationLinks} />
      <FooterLinkGroup title="Connect" pageLinks={siteConfig.socialLinks} />
      <FooterLinkGroup title="Legal" pageLinks={legalLink} />
    </div>

    <div class="border-border/70 border-t pt-8 text-center text-xs">
      <span class="text-muted-foreground">
        2018 - {new Date().getFullYear()} &copy; {siteConfig.author}
      </span>
    </div>
  </Container>
</footer>
