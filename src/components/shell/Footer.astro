---
import { Container } from "@/components/common/primitives";
import SocialLinks from "@/components/common/SocialLinks.astro";
import siteConfig from "@/config/site";
---

<footer class="border-t border-border mt-24">
	<Container
		class="flex flex-col items-center justify-between gap-3 py-6 text-sm sm:flex-row"
	>
		<div
			class="flex flex-col items-center gap-1 text-center sm:flex-row sm:gap-x-4 sm:gap-y-0 sm:text-left text-muted-foreground"
		>
			<p>
				&copy; {`${new Date().getFullYear()} ${siteConfig.author}`}
			</p>
			<span class="hidden sm:inline">&middot;</span>
			<a href="/legal" class="hover:text-foreground transition-colors">Legal</a>
		</div>
		<SocialLinks variant="icon" />
	</Container>
</footer>
