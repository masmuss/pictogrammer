{/* Inlined to avoid FOUC. This is a parser blocking script. */}
<script is:inline>
	const darkModePref = window.matchMedia("(prefers-color-scheme: dark)");

	function getUserPref() {
		const storedTheme =
			typeof localStorage !== "undefined" && localStorage.getItem("theme");
		return storedTheme === "light" || storedTheme === "dark"
			? storedTheme
			: darkModePref.matches
				? "dark"
				: "light";
	}

	let transitionTimeout;

	function setTheme(newTheme) {
		if (newTheme !== "light" && newTheme !== "dark") {
			return console.warn(
				`Invalid theme value '${newTheme}' received. Expected 'light' or 'dark'.`
			);
		}

		const root = document.documentElement;
		const isDark = newTheme === "dark";

		if (isDark === root.classList.contains("dark")) {
			root.setAttribute("data-theme", newTheme);
			return;
		}

		root.classList.add("theme-transitioning");
		root.classList.toggle("dark", isDark);
		root.setAttribute("data-theme", newTheme);

		clearTimeout(transitionTimeout);
		transitionTimeout = setTimeout(() => {
			root.classList.remove("theme-transitioning");
		}, 250);

		if (typeof localStorage !== "undefined") {
			localStorage.setItem("theme", newTheme);
		}
	}

	setTheme(getUserPref());

	document.addEventListener("astro:before-swap", (event) => {
		const theme = getUserPref();
		const incomingRoot = event.newDocument.documentElement;
		if (!incomingRoot) return;

		incomingRoot.classList.toggle("dark", theme === "dark");
		incomingRoot.setAttribute("data-theme", theme);
	});

	document.addEventListener("astro:after-swap", () => setTheme(getUserPref()));

	document.addEventListener("theme-change", (event) => {
		if (!(event instanceof CustomEvent)) return;
		const theme = event.detail?.theme;
		if (typeof theme !== "string") return;
		setTheme(theme);
	});

	darkModePref.addEventListener("change", (e) =>
		setTheme(e.matches ? "dark" : "light")
	);

	// Global Keyboard shortcut 'd' to toggle theme
	document.addEventListener("keydown", (e) => {
		// Ignore if user is typing in an input or textarea
		const target = e.target;
		const isInput =
			target.tagName === "INPUT" ||
			target.tagName === "TEXTAREA" ||
			target.isContentEditable;

		if (!isInput && (e.key === "d" || e.key === "D")) {
			const isDark = document.documentElement.classList.contains("dark");
			const newTheme = isDark ? "light" : "dark";

			// Dispatch event so ThemeToggle and other components can sync
			const themeChangeEvent = new CustomEvent("theme-change", {
				detail: { theme: newTheme }
			});
			document.dispatchEvent(themeChangeEvent);
		}
	});
</script>
