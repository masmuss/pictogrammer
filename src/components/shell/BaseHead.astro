---
import "@/assets/styles/global.css";
import { Font } from "astro:assets";
import Seo from "@/components/common/Seo.astro";
import { markdownPath } from "@/lib/negotiation";

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; alt?: string };
	pageType?: "website" | "article";
	date?: Date;
	updatedDate?: Date;
	breadcrumbs?: Array<{ name: string; item: string }>;
}

const {
	title,
	description,
	image,
	pageType = "website",
	date,
	updatedDate,
	breadcrumbs
}: Props = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isNotFound = normalizedPath === "/404" || normalizedPath === "/404.html";
const markdownHref = isNotFound ? undefined : markdownPath(Astro.url.pathname);
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<Seo
	title={title}
	description={description}
	ogType={pageType}
	ogImage={image?.src}
	ogImageAlt={image?.alt}
	article={pageType === "article"
		? { publishedTime: date, modifiedTime: updatedDate }
		: undefined}
	breadcrumbs={breadcrumbs}
	extraLinks={[
		{
			rel: "apple-touch-icon",
			sizes: "180x180",
			href: "/favicon/apple-touch-icon.png"
		},
		{
			rel: "icon",
			type: "image/png",
			sizes: "192x192",
			href: "/favicon/android-chrome-192x192.png"
		},
		{
			rel: "icon",
			type: "image/png",
			sizes: "32x32",
			href: "/favicon/favicon-32x32.png"
		},
		{
			rel: "icon",
			type: "image/png",
			sizes: "16x16",
			href: "/favicon/favicon-16x16.png"
		},
		{ rel: "manifest", href: "/favicon/site.webmanifest" },
		{ rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
		{
			rel: "icon",
			href: "/favicon.svg",
			type: "image/svg+xml",
			media: "(prefers-color-scheme: light)"
		},
		{ rel: "sitemap", href: "/sitemap-index.xml" },
		...(markdownHref
			? [
					{
						rel: "alternate",
						type: "text/markdown",
						href: markdownHref,
						title: "Markdown"
					}
				]
			: []),
		{
			rel: "alternate",
			type: "application/rss+xml",
			href: "/rss.xml",
			title: "RSS"
		}
	]}
/>

<!-- Fonts -->
<Font cssVariable="--font-merriweather" />
<Font cssVariable="--font-geist-sans" />
<Font cssVariable="--font-geist-mono" />

<!-- Theme Colors -->
<meta
	name="theme-color"
	content="#100f0f"
	media="(prefers-color-scheme: dark)"
/>
<meta
	name="theme-color"
	content="#fffcf0"
	media="(prefers-color-scheme: light)"
/>
