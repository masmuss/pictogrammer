---
import "@/assets/styles/global.css";
import { Font } from "astro:assets";
import Seo from "@/components/common/Seo.astro";
import type { SeoExtraLink } from "@/components/common/seo/types";
import siteConfig from "@/config/site";
import { markdownPath } from "@/lib/negotiation";

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; alt?: string };
	pageType?: "website" | "article";
	date?: Date;
	updatedDate?: Date;
	breadcrumbs?: Array<{ name: string; item: string }>;
	robots?: string;
}

const {
	title,
	description,
	image,
	pageType = "website",
	date,
	updatedDate,
	breadcrumbs,
	robots,
}: Props = Astro.props;

const normalizedPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isNotFound = normalizedPath === "/404" || normalizedPath === "/404.html";
const markdownHref = isNotFound ? undefined : markdownPath(Astro.url.pathname);

const extraLinks: SeoExtraLink[] = [
	...siteConfig.faviconLinks,
	...(markdownHref
		? [
				{
					rel: "alternate",
					type: "text/markdown",
					href: markdownHref,
					title: "Markdown",
				},
			]
		: []),
	{
		rel: "alternate",
		type: "application/rss+xml",
		href: "/rss.xml",
		title: "RSS",
	},
];
---

<!-- High Priority Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<Seo
	title={title}
	description={description}
	ogType={pageType}
	ogImage={image?.src}
	ogImageAlt={image?.alt}
	article={
		pageType === "article"
			? { publishedTime: date, modifiedTime: updatedDate }
			: undefined
	}
	breadcrumbs={breadcrumbs}
	robots={robots}
	extraLinks={extraLinks}
/>

<!-- Fonts -->
<Font cssVariable="--font-merriweather" />
<Font cssVariable="--font-geist-sans" />
<Font cssVariable="--font-geist-mono" />

<!-- Theme Colors -->
<meta
	name="theme-color"
	content="#100f0f"
	media="(prefers-color-scheme: dark)"
/>
<meta
	name="theme-color"
	content="#fffcf0"
	media="(prefers-color-scheme: light)"
/>
