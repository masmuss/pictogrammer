---
import { Icon } from "astro-icon/components";

interface Props {
	href: string;
	text: string;
	icon?: string;
}

const { href, text, icon } = Astro.props;
---

<a
	{href}
	class="text-muted-foreground hover:text-accent-cta-text flex flex-none font-medium transition-colors focus:outline-none md:items-center"
	aria-label={text}
>
	<span class="hidden md:inline">{text}</span>
	{icon && <Icon name={icon} class="md:hidden" />}
</a>
