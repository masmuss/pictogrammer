---
type Props = {
	title: string;
	pageLinks: { href: string; text: string }[];
};

const { title, pageLinks } = Astro.props as Props;
---

<div class="space-y-4">
  <h2 class="text-foreground text-sm font-semibold tracking-widest uppercase">
    {title}
  </h2>
  <ul class="space-y-2">
    {
      pageLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-muted-foreground hover:text-foreground transition-colors"
          >
            {link.text}
          </a>
        </li>
      ))
    }
  </ul>
</div>
