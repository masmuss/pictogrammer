---
interface Props {
	href: string;
	text: string;
	icon?: string;
}

const { href, text, icon } = Astro.props;
---

<a
	{href}
	class="text-muted-foreground hover:text-foreground flex flex-none font-medium transition-colors focus:ring-1 focus:ring-offset-1 focus:outline-none md:items-center"
	aria-label={text}
>
	<span class="hidden md:inline">{text}</span>
	{icon && <span class={`iconify ${icon} md:hidden`} />}
</a>
