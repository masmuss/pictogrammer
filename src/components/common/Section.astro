---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/tailwind";
import Heading from "./Heading.astro";

interface Props extends HTMLAttributes<"section"> {
	class?: string;
	title?: string;
	titleAs?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
	titleSize?: "3xl" | "2xl" | "xl" | "lg" | "base" | "sm";
	titleWeight?: "bold" | "semibold" | "medium" | "light";
	transitionDelay?: number;
}

const {
	class: className,
	title,
	titleAs = "h2",
	titleSize = "xl",
	titleWeight = "semibold",
	transitionDelay = 0,
	...attrs
}: Props = Astro.props;
---

<section
	data-fade-up="true"
	class={cn(
		className,
		"flex flex-col gap-y-4 pt-12",
		"opacity-0 translate-y-3 transition-[opacity,transform] ease-out"
	)}
	style={transitionDelay > 0
		? {
				transitionDuration: "var(--duration-slower)",
				transitionDelay: `${transitionDelay}ms`
			}
		: { transitionDuration: "var(--duration-slower)" }}
	{...attrs}
>
	{
		title && (
			<Heading
				as={titleAs}
				size={titleSize}
				weight={titleWeight}
				class="text-foreground tracking-tight"
			>
				{title}
			</Heading>
		)
	}
	<div class="flex flex-col gap-y-3">
		<slot />
	</div>
</section>

<script>
	function observeFadeUp() {
		if (document.readyState !== "loading") {
			setupObserver();
		} else {
			document.addEventListener("DOMContentLoaded", setupObserver);
		}
	}

	function setupObserver() {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			document.querySelectorAll('[data-fade-up="true"]').forEach((el) => {
				el.classList.remove("opacity-0", "translate-y-4");
				el.classList.add("opacity-100", "translate-y-0");
			});
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.remove("opacity-0", "translate-y-4");
						entry.target.classList.add("opacity-100", "translate-y-0");
						observer.unobserve(entry.target);
					}
				});
			},
			{
				rootMargin: "0px",
				threshold: 0.1
			}
		);

		document.querySelectorAll('[data-fade-up="true"]').forEach((element) => {
			observer.observe(element);
		});
	}

	observeFadeUp();
	document.addEventListener("astro:page-load", observeFadeUp);
</script>
