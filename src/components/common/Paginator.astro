---
import Button from "@/components/ui/button/Button.astro";
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl }: Props = Astro.props;

interface PaginatorLink {
	url: string;
	text: string;
	srLabel?: string;
	className: string;
}

const links: PaginatorLink[] = [];
if (prevUrl) {
	links.push({
		url: prevUrl.url,
		text: prevUrl.text || "Previous",
		srLabel: prevUrl.srLabel,
		className: "me-auto"
	});
}
if (nextUrl) {
	links.push({
		url: nextUrl.url,
		text: nextUrl.text || "Next",
		srLabel: nextUrl.srLabel,
		className: "ms-auto"
	});
}
---

{
	links.length > 0 && (
		<nav aria-label="Pagination" class="mt-8 flex items-center gap-x-4">
			{links.map(({ url, text, srLabel, className }) => (
				<Button as="a" href={url} variant="ghost" size="sm" class={className}>
					{srLabel && <span class="sr-only">{srLabel}</span>}
					{text}
				</Button>
			))}
		</nav>
	)
}
