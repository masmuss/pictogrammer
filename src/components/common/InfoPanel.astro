---
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { cn } from "@/lib/utils/tailwind";
import Stack from "./primitives/Stack.astro";

interface Props {
	title: string;
	titleAs?: keyof HTMLElementTagNameMap;
	titleClass?: string;
	contentClass?: string;
	class?: string;
}

const {
	title,
	titleAs = "h2",
	titleClass = "text-muted-foreground text-xs font-medium tracking-widest uppercase",
	contentClass = "",
	class: className = "",
	...attrs
}: Props = Astro.props;
---

<section {...attrs} class={className}>
	<Card class="gap-0 ring-0 bg-transparent">
		<CardHeader class="border-border border-b px-0">
			<CardTitle class={titleClass}>
				{title}
			</CardTitle>
		</CardHeader>
		<CardContent class={cn("px-4", contentClass)}>
			<Stack gap="md">
				<slot />
			</Stack>
		</CardContent>
	</Card>
</section>
