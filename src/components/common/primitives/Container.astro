---
import { cn } from "@/lib/utils/tailwind";

interface Props {
	class?: string;
	maxWidth?: string;
}

type HTMLDivElement = astroHTML.JSX.IntrinsicElements["div"];

const {
	class: className,
	maxWidth = "max-w-5xl",
	...attrs
} = Astro.props as Props & HTMLDivElement;

const classes = cn("mx-auto w-full px-6 sm:px-8 md:px-12", maxWidth, className);
---

<div class={classes} {...attrs}>
	<slot />
</div>
