---
import JsonLd from "@/components/shell/JsonLd.astro";
import siteConfig from "@/config/site";
import {
	formatCanonicalURL,
	normalizeDescription,
	normalizeTitle
} from "@/lib/utils/seo";

interface Props {
	title?: string;
	titleTemplate?: string;
	description?: string;
	ogType?: "website" | "article";
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	siteName?: string;
	twitter?: {
		site?: string;
		creator?: string;
		card?: "summary" | "summary_large_image";
	};
	article?: {
		publishedTime?: Date;
		modifiedTime?: Date;
		author?: string;
		tags?: string[];
	};
	extraLinks?: Array<{
		title?: string;
		rel: string;
		href: string;
		type?: string;
		media?: string;
		sizes?: string;
	}>;
	breadcrumbs?: Array<{ name: string; item: string }>;
}

const {
	title: rawTitle,
	titleTemplate = siteConfig.title,
	description: rawDescription,
	ogType = "website",
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	siteName = siteConfig.title,
	twitter = { card: "summary_large_image" },
	article,
	extraLinks = [],
	breadcrumbs
} = Astro.props;

const title = normalizeTitle(rawTitle, siteConfig.title, titleTemplate);
const description = normalizeDescription(
	rawDescription,
	ogType === "article"
		? "Read this article on pictogrammmer for practical lessons, context, and related insights from Khoirul Fattah."
		: siteConfig.description,
	ogType === "article"
);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const formattedCanonical = formatCanonicalURL(canonicalURL);

const resolvedOgImage = ogImage
	? new URL(ogImage, Astro.site).toString()
	: new URL(siteConfig.image.src, Astro.site).toString();

const resolvedOgImageAlt = ogImageAlt || siteConfig.image.alt;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={formattedCanonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={formattedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
{
	resolvedOgImageAlt && (
		<meta property="og:image:alt" content={resolvedOgImageAlt} />
	)
}
{siteName && <meta property="og:site_name" content={siteName} />}
{
	ogImageWidth && (
		<meta property="og:image:width" content={ogImageWidth.toString()} />
	)
}
{
	ogImageHeight && (
		<meta property="og:image:height" content={ogImageHeight.toString()} />
	)
}

{
	ogType === "article" && article && (
		<>
			{article.publishedTime && (
				<meta
					property="article:published_time"
					content={article.publishedTime.toISOString()}
				/>
			)}
			{article.modifiedTime && (
				<meta
					property="article:modified_time"
					content={article.modifiedTime.toISOString()}
				/>
			)}
			{article.author && (
				<meta property="article:author" content={article.author} />
			)}
			{article.tags?.map((tag) => (
				<meta property="article:tag" content={tag} />
			))}
		</>
	)
}

<!-- Twitter -->
<meta property="twitter:card" content={twitter.card || "summary_large_image"} />
<meta property="twitter:url" content={formattedCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />
{
	resolvedOgImageAlt && (
		<meta name="twitter:image:alt" content={resolvedOgImageAlt} />
	)
}
{twitter.site && <meta name="twitter:site" content={twitter.site} />}
{twitter.creator && <meta name="twitter:creator" content={twitter.creator} />}

<!-- JSON-LD -->
<JsonLd
	title={title}
	description={description}
	image={resolvedOgImage}
	date={article?.publishedTime}
	updatedDate={article?.modifiedTime}
	type={ogType}
	breadcrumbs={breadcrumbs}
/>

<!-- Extra Links -->
{
	extraLinks.map((link) => (
		<link
			title={link.title}
			rel={link.rel}
			href={link.href}
			type={link.type}
			media={link.media}
			sizes={link.sizes}
		/>
	))
}
