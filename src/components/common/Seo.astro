---
import JsonLd from "@/components/shell/JsonLd.astro";
import siteConfig from "@/config/site";
import {
	formatCanonicalURL,
	normalizeDescription,
	normalizeTitle
} from "@/lib/utils/seo";
import SeoExtraLinks from "./seo/SeoExtraLinks.astro";
import SeoMeta from "./seo/SeoMeta.astro";
import SeoSocialMeta from "./seo/SeoSocialMeta.astro";
import type {
	SeoArticle,
	SeoBreadcrumb,
	SeoExtraLink,
	SeoTwitter
} from "./seo/types";

interface Props {
	title?: string;
	titleTemplate?: string;
	description?: string;
	ogType?: "website" | "article";
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	siteName?: string;
	twitter?: SeoTwitter;
	article?: SeoArticle;
	extraLinks?: SeoExtraLink[];
	breadcrumbs?: SeoBreadcrumb[];
}

const {
	title: rawTitle,
	titleTemplate = siteConfig.title,
	description: rawDescription,
	ogType = "website",
	ogImage,
	ogImageAlt,
	ogImageWidth,
	ogImageHeight,
	siteName = siteConfig.title,
	twitter = { card: "summary_large_image" },
	article,
	extraLinks = [],
	breadcrumbs
} = Astro.props;

const title = normalizeTitle(rawTitle, siteConfig.title, titleTemplate);
const description = normalizeDescription(
	rawDescription,
	ogType === "article"
		? "Read this article on pictogrammmer for practical lessons, context, and related insights from Khoirul Fattah."
		: siteConfig.description,
	ogType === "article"
);

const formattedCanonical = formatCanonicalURL(
	new URL(Astro.url.pathname, Astro.site)
);
const resolvedOgImage = ogImage
	? new URL(ogImage, Astro.site).toString()
	: new URL(siteConfig.image.src, Astro.site).toString();
const resolvedOgImageAlt = ogImageAlt || siteConfig.image.alt;
---

<SeoMeta
	title={title}
	description={description}
	canonical={formattedCanonical}
/>
<SeoSocialMeta
	ogType={ogType}
	title={title}
	description={description}
	image={resolvedOgImage}
	imageAlt={resolvedOgImageAlt}
	imageWidth={ogImageWidth}
	imageHeight={ogImageHeight}
	siteName={siteName}
	twitter={twitter}
	article={article}
/>
<meta property="og:url" content={formattedCanonical} />
<meta property="twitter:url" content={formattedCanonical} />
<JsonLd
	title={title}
	description={description}
	image={resolvedOgImage}
	date={article?.publishedTime}
	updatedDate={article?.modifiedTime}
	type={ogType}
	breadcrumbs={breadcrumbs}
/>
<SeoExtraLinks links={extraLinks} />
