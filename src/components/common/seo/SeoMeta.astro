---
interface Props {
	title: string;
	description: string;
	canonical: string;
	locale?: string;
	robots?: string;
}

const {
	title,
	description,
	canonical,
	locale = "en_US",
	robots = "index, follow, max-image-preview:large",
} = Astro.props;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content={locale} />
