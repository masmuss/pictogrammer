---
import type { SeoArticle, SeoTwitter } from "./types";

interface Props {
	ogType: "website" | "article";
	title: string;
	description: string;
	image: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	siteName?: string;
	twitter: SeoTwitter;
	article?: SeoArticle;
}

interface OgMeta {
	property: string;
	content: string;
}

interface TwitterMeta {
	property?: string;
	name?: string;
	content: string;
}

const {
	ogType,
	title,
	description,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	siteName,
	twitter,
	article
} = Astro.props;

const ogMetas: OgMeta[] = [
	{ property: "og:type", content: ogType },
	{ property: "og:title", content: title },
	{ property: "og:description", content: description },
	{ property: "og:image", content: image }
];

if (imageAlt) {
	ogMetas.push({ property: "og:image:alt", content: imageAlt });
}
if (siteName) {
	ogMetas.push({ property: "og:site_name", content: siteName });
}
if (imageWidth) {
	ogMetas.push({
		property: "og:image:width",
		content: imageWidth.toString()
	});
}
if (imageHeight) {
	ogMetas.push({
		property: "og:image:height",
		content: imageHeight.toString()
	});
}

if (ogType === "article" && article) {
	if (article.publishedTime) {
		ogMetas.push({
			property: "article:published_time",
			content: article.publishedTime.toISOString()
		});
	}
	if (article.modifiedTime) {
		ogMetas.push({
			property: "article:modified_time",
			content: article.modifiedTime.toISOString()
		});
	}
	if (article.author) {
		ogMetas.push({ property: "article:author", content: article.author });
	}
	for (const tag of article.tags ?? []) {
		ogMetas.push({ property: "article:tag", content: tag });
	}
}

const twitterPropertyMetas: TwitterMeta[] = [
	{
		property: "twitter:card",
		content: twitter.card || "summary_large_image"
	},
	{ property: "twitter:title", content: title },
	{ property: "twitter:description", content: description },
	{ property: "twitter:image", content: image }
];

const twitterNameMetas: TwitterMeta[] = [];
if (imageAlt) {
	twitterNameMetas.push({ name: "twitter:image:alt", content: imageAlt });
}
if (twitter.site) {
	twitterNameMetas.push({ name: "twitter:site", content: twitter.site });
}
if (twitter.creator) {
	twitterNameMetas.push({ name: "twitter:creator", content: twitter.creator });
}
---

{
	ogMetas.map(({ property, content }) => (
		<meta property={property} content={content} />
	))
}
{
	twitterPropertyMetas.map(({ property, content }) => (
		<meta property={property} content={content} />
	))
}
{
	twitterNameMetas.map(({ name, content }) => (
		<meta name={name} content={content} />
	))
}
