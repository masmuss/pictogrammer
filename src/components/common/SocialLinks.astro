---
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/button/Button.astro";
import {
	Tooltip,
	TooltipContent,
	TooltipTrigger
} from "@/components/ui/tooltip";
import siteConfig from "@/config/site-config";
import { cn } from "@/lib/utils/tailwind";

interface Props {
	variant?: "icon" | "button";
	showEmail?: boolean;
	showCV?: boolean;
	class?: string;
}

const {
	variant = "icon",
	showEmail = false,
	showCV = false,
	class: className
} = Astro.props;

const isButton = variant === "button";
const buttonVariant = isButton ? "outline" : "ghost";
const buttonSize = isButton ? "default" : "icon-sm";
const buttonClass = cn(
	"text-muted-foreground hover:text-foreground",
	isButton && "gap-x-2"
);

const links = [
	...(showEmail
		? [
				{
					href: `mailto:${siteConfig.email}`,
					text: "Email",
					icon: "ph:envelope"
				}
			]
		: []),
	...siteConfig.socialLinks.map((link) => ({
		href: link.href,
		text: link.text,
		icon: link.icon
	}))
];
---

<div
	class={cn(
		"flex items-center",
		isButton ? "flex-wrap gap-3" : "gap-4",
		className
	)}
>
	{
		showCV && siteConfig.cvLink && (
			<Button
				as="a"
				href={siteConfig.cvLink}
				target="_blank"
				rel="noopener noreferrer"
				variant="outline"
			>
				<Icon name="ph:file-arrow-down" />
				View Resume
			</Button>
		)
	}
	{
		links.map((link) => (
			<Tooltip delay={0}>
				<TooltipTrigger asChild>
					<Button
						as="a"
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
						variant={buttonVariant}
						size={buttonSize}
						class={buttonClass}
						aria-label={link.text}
					>
						<Icon name={link.icon} />
						{!isButton && <span class="sr-only">{link.text}</span>}
					</Button>
				</TooltipTrigger>
				<TooltipContent side="top">{link.text}</TooltipContent>
			</Tooltip>
		))
	}
</div>
