---
import Button from "@/components/ui/Button.astro";
import siteConfig from "@/config/site-config";
import { cn } from "@/lib/utils";
import { Icon } from "../ui/primitives";

interface Props {
	variant?: "icon" | "button";
	showEmail?: boolean;
	showCV?: boolean;
	class?: string;
}

const {
	variant = "icon",
	showEmail = false,
	showCV = false,
	class: className
} = Astro.props;

const isButton = variant === "button";
const buttonVariant = isButton ? "outline" : "ghost";
const buttonSize = isButton ? "default" : "icon-sm";
const buttonClass = cn(
	"text-muted-foreground hover:text-foreground",
	isButton && "gap-x-2"
);

const links = [
	...(showEmail
		? [
				{
					href: `mailto:${siteConfig.email}`,
					text: "Email",
					icon: "envelope"
				}
			]
		: []),
	...siteConfig.socialLinks.map((link) => ({
		href: link.href,
		text: link.text,
		icon: link.icon
	}))
];
---

<div
  class={cn(
    "flex items-center",
    isButton ? "flex-wrap gap-3" : "gap-4",
    className,
  )}
>
  {
    showCV && siteConfig.cvLink && (
      <Button
        as="a"
        href={siteConfig.cvLink}
        target="_blank"
        rel="noopener noreferrer"
        variant="outline"
      >
        <Icon slot="icon-before" name="file-arrow-down"/>
        View Resume
      </Button>
    )
  }
  {
    links.map((link) => (
      <Button
        as="a"
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        variant={buttonVariant}
        size={buttonSize}
        class={buttonClass}
        aria-label={link.text}
        title={isButton ? link.text : undefined}
      >
        <Icon slot="icon-before" name={link.icon} class:list={
          [!isButton && "text-xl"]
        } />
        {!isButton && <span class="sr-only">{link.text}</span>}
      </Button>
    ))
  }
</div>
