---
import Heading from "@/components/ui/Heading.astro";

interface Props {
	name: string;
	description: string;
	showDescription?: boolean;
}

const { name, description, showDescription } = Astro.props;
---

<li class="flex flex-col" data-testid="tool-item">
	<div class="flex flex-col">
		<Heading
			as="h3"
			size="sm"
			weight="medium"
			class="text-foreground font-medium"
		>
			{name}
		</Heading>
		{
			showDescription && (
				<p class="text-muted-foreground mt-px text-xs leading-relaxed">
					{description}
				</p>
			)
		}
	</div>
</li>
