---
import { Icon } from "astro-icon/components";
import Heading from "@/components/common/Heading.astro";

interface Props {
	name: string;
	description: string;
	showDescription?: boolean;
	href?: string;
}

const { name, description, showDescription, href } = Astro.props;
---

<li class="flex flex-col" data-testid="tool-item">
	<div class="flex flex-col">
		{href ? (
			<a
				href={href}
				class="group/tool-item focus-visible:outline-ring flex w-fit items-center gap-2 rounded focus-visible:outline-2"
				target="_blank"
				rel="noopener noreferrer"
			>
				<Heading as="h3" size="sm" weight="medium" class="text-foreground">
					{name}
				</Heading>
				<Icon
					name="ph:arrow-up-right"
					class="text-muted-foreground opacity-0 transition-opacity duration-200 group-hover/tool-item:opacity-100"
					aria-hidden="true"
				/>
			</a>
		) : (
			<Heading as="h3" size="sm" weight="medium" class="text-foreground">
				{name}
			</Heading>
		)}
		{showDescription && (
			<p class="text-muted-foreground mt-px text-xs leading-relaxed">
				{description}
			</p>
		)}
	</div>
</li>
