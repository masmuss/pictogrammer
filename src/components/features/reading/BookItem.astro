---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Heading from "@/components/common/Heading.astro";
import Badge from "@/components/ui/badge/Badge.astro";

type Book = CollectionEntry<"reading">["data"][number];

interface Props {
	book: Book;
}

const { book } = Astro.props;
---

<a
	href={book.url || "#"}
	target={book.url ? "_blank" : "_self"}
	rel={book.url ? "noopener noreferrer" : ""}
	class="group flex flex-col gap-3 border border-transparent transition-all hover:-translate-y-1 hover:border-foreground/20 p-4"
	data-testid="book-item"
>
	<div
		class="relative aspect-2/3 w-full overflow-hidden rounded-md bg-muted flex items-center justify-center"
	>
		{
			book.cover ? (
				<img
					src={book.cover}
					alt={`Cover of ${book.title}`}
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
					loading="lazy"
				/>
			) : (
				<div class="flex h-full w-full flex-col items-center justify-center p-4 text-center">
					<Heading as="h4" size="xs" class="text-muted-foreground/50">
						{book.title}
					</Heading>
				</div>
			)
		}

		{
			book.status === "reading" && (
				<Badge class="absolute right-2 top-2">Reading</Badge>
			)
		}
	</div>

	<div class="flex flex-1 flex-col justify-between gap-2">
		<div>
			<Heading
				as="h3"
				size="sm"
				weight="semibold"
				class="line-clamp-2 leading-tight"
			>
				{book.title}
			</Heading>
			<p class="text-xs text-muted-foreground mt-1">{book.author}</p>
			{
				book.dateRead && (
					<p class="mt-0.5 text-[10px] uppercase tracking-wider text-muted-foreground">
						Read in {book.dateRead}
					</p>
				)
			}
		</div>

		<div class="flex flex-col gap-1 mt-2">
			{
				book.rating && (
					<div
						class="flex items-center gap-0.5 text-muted-foreground"
						aria-label={`Rating: ${book.rating} out of 5`}
					>
						{Array.from({ length: 5 }).map((_, i) => (
							<Icon
								name={i < book.rating! ? "ph:star-fill" : "ph:star"}
								class="size-3.5"
							/>
						))}
					</div>
				)
			}
		</div>
	</div>
</a>
