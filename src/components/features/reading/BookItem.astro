---
import type { CollectionEntry } from "astro:content";
import Heading from "@/components/common/Heading.astro";
import Badge from "@/components/ui/badge/Badge.astro";
import BookRating from "./BookRating.astro";

type Book = CollectionEntry<"reading">["data"][number];

interface Props {
	book: Book;
}

const { book } = Astro.props;

const Wrapper = book.url ? "a" : "div";
const wrapperProps = book.url
	? {
			href: book.url,
			target: "_blank",
			rel: "noopener noreferrer"
		}
	: {};
---

<Wrapper
	{...wrapperProps}
	class="group hover:border-border flex flex-col gap-3 rounded-lg border border-transparent p-4 transition-colors duration-200"
	data-testid="book-item"
>
	<div class="bg-muted relative flex aspect-2/3 min-h-28 w-full items-center justify-center overflow-hidden rounded-lg">
		{book.cover ? (
			<img
				src={book.cover}
				alt={`Cover of ${book.title}`}
				class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
				loading="lazy"
			/>
		) : (
			<div class="flex h-full w-full flex-col items-center justify-center p-4 text-center">
				<Heading as="h4" size="xs" class="text-muted-foreground">
					{book.title}
				</Heading>
			</div>
		)}

		{book.status === "reading" && (
			<Badge class="absolute top-2 right-2" size="sm">
				Reading
			</Badge>
		)}
	</div>

	<div class="flex flex-1 flex-col justify-between gap-2">
		<div>
			<Heading
				as="h3"
				size="sm"
				weight="semibold"
				class="line-clamp-2 leading-tight"
			>
				{book.title}
			</Heading>
			<p class="text-muted-foreground mt-1 text-xs">{book.author}</p>
			{book.dateRead && (
				<p class="text-muted-foreground mt-0.5 text-[10px] tracking-wider uppercase">
					Read in {book.dateRead}
				</p>
			)}
		</div>

		<div class="mt-2 flex flex-col gap-1">
			<BookRating rating={book.rating} />
		</div>
	</div>
</Wrapper>
