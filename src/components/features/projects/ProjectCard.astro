---
import { Icon } from "astro-icon/components";
import {
	Card,
	CardContent,
	CardDescription,
	CardTitle
} from "@/components/ui/card";
import { CATEGORY_ICONS } from "@/lib/contents/projects";
import { cn } from "@/lib/utils/tailwind";

interface Props {
	href?: string;
	liveHref?: string;
	repoHref?: string;
	heading: string;
	subheading?: string;
	icon?: string;
	category?: string;
	class?: string;
}

const {
	href,
	liveHref,
	repoHref,
	heading,
	subheading,
	icon,
	category,
	class: className
} = Astro.props;

const fallbackIcon = CATEGORY_ICONS[category ?? ""];
const displayIcon = icon ?? fallbackIcon;
const effectiveLiveHref = liveHref ?? (!repoHref ? href : undefined);
---

<Card
	class={cn(
		"border border-transparent rounded-lg bg-transparent px-0 relative group-has-[:hover]/list:opacity-50 hover:opacity-100 transition-all hover:shadow-md hover:border-border hover:bg-card isolate duration-200",
		className
	)}
	variant="ghost"
	data-testid="project-item"
>
	<CardContent class="flex flex-row items-center h-full gap-6">
		{
			displayIcon && (
				<div class="text-muted-foreground mt-1 flex shrink-0 items-center justify-center rounded-md">
					<Icon name={displayIcon} class="text-3xl" aria-hidden="true" />
				</div>
			)
		}
		<div>
			<CardTitle>
				{
					effectiveLiveHref ? (
						<a
							href={effectiveLiveHref}
							target={
								effectiveLiveHref.startsWith("http") ? "_blank" : undefined
							}
							rel={
								effectiveLiveHref.startsWith("http")
									? "noopener noreferrer"
									: undefined
							}
							class="before:absolute before:inset-0 focus-visible:outline-2 focus-visible:outline-ring rounded"
						>
							{heading}
						</a>
					) : (
						heading
					)
				}
			</CardTitle>
			{
				repoHref && (
					<a
						href={repoHref}
						target="_blank"
						rel="noopener noreferrer"
						class="text-muted-foreground hover:text-foreground transition-colors absolute top-4 right-4 z-10 p-1 focus-visible:outline-2 focus-visible:outline-ring rounded"
						aria-label="Repository"
						title="Source Code"
					>
						<Icon name="ph:github-logo" class="text-lg" aria-hidden="true" />
					</a>
				)
			}
			{
				subheading && (
					<CardDescription class="line-clamp-2 text-sm mt-1">
						{subheading}
					</CardDescription>
				)
			}
		</div>
	</CardContent>
</Card>
