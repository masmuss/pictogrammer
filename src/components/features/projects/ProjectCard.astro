---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import Button from "@/components/ui/Button.astro";
import {
	Card,
	CardDescription,
	CardFooter,
	CardHeader,
	CardTitle
} from "@/components/ui/card";
import { CATEGORY_ICONS } from "@/lib/contents/projects";
import { cn } from "@/lib/utils/tailwind";

interface Props {
	href?: string;
	liveHref?: string;
	repoHref?: string;
	heading: string;
	subheading?: string;
	thumbnail?: string;
	category?: string;
	class?: string;
}

const {
	href,
	liveHref,
	repoHref,
	heading,
	subheading,
	thumbnail,
	category,
	class: className
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/**/*.{jpeg,jpg,png,gif,webp,avif}"
);

let thumbnailImage: { default: ImageMetadata } | undefined;
if (thumbnail) {
	const candidates = [
		thumbnail,
		`/src/assets/images/projects/${thumbnail}`,
		`/src/assets/images/${thumbnail}`
	];
	const path = candidates.find((candidate) => Boolean(images[candidate]));
	if (path) {
		const loader = images[path];
		if (loader) thumbnailImage = await loader();
	}
}

const placeholderIcon = thumbnailImage ? null : CATEGORY_ICONS[category ?? ""];

const effectiveLiveHref = liveHref ?? (!repoHref ? href : undefined);
const effectiveRepoHref = repoHref;
---

<Card
	class={cn(
		"w-full gap-0 transition-all duration-fast hover:-translate-y-0.5 hover:ring-primary/40 active:scale-[0.98] scroll-reveal",
		className
	)}
>
	{
		thumbnailImage ? (
			<Image
				src={thumbnailImage.default}
				alt={`${heading} thumbnail`}
				class="aspect-video w-full rounded-sm object-cover"
				loading="lazy"
			/>
		) : (
			<div class="bg-muted flex aspect-video w-full items-center justify-center rounded-sm">
				{placeholderIcon && (
					<Icon
						name={placeholderIcon}
						class="text-muted-foreground/40 text-4xl"
					/>
				)}
			</div>
		)
	}
	<CardHeader class="flex flex-1 flex-col px-0">
		<CardTitle class="text-base">{heading}</CardTitle>
		{
			subheading && (
				<CardDescription class="line-clamp-2 text-xs">
					{subheading}
				</CardDescription>
			)
		}
	</CardHeader>

	{
		(effectiveRepoHref || effectiveLiveHref) && (
			<CardFooter class="flex flex-row items-center gap-2 px-0 pb-0 mt-4">
				{effectiveRepoHref && (
					<Button
						as="a"
						href={effectiveRepoHref}
						target="_blank"
						rel="noopener noreferrer"
						variant="secondary"
						size="sm"
						class="flex-1"
					>
						<Icon name="ph:github-logo" aria-hidden="true" />
						Repo
					</Button>
				)}

				{effectiveLiveHref && (
					<Button
						as="a"
						href={effectiveLiveHref}
						target="_blank"
						rel="noopener noreferrer"
						variant="default"
						size="sm"
						class="flex-1"
					>
						<Icon name="ph:arrow-square-out" aria-hidden="true" />
						Live
					</Button>
				)}
			</CardFooter>
		)
	}
</Card>
