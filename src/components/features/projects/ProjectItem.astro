---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/ui/badge";
import { getLanguageColor } from "@/lib/contents/projects";
import { cn } from "@/lib/utils";
import type { Project } from "@/types";
import ProjectLinks from "./ProjectLinks.astro";

interface Props extends HTMLAttributes<"li"> {
	project: Project;
	variant?: "row" | "card";
	showDescription?: boolean;
}

const {
	project,
	variant = "row",
	showDescription = false,
	class: className,
	...attrs
} = Astro.props;

const languageColor = project.language
	? getLanguageColor(project.language)
	: undefined;

const href = project.liveHref ?? project.repoHref ?? project.href;
const TitleTag = href ? "a" : "span";
const titleProps = href
	? { href, target: "_blank", rel: "noopener noreferrer" }
	: {};

const isLive = Boolean(project.liveHref);
const hasRepo = Boolean(project.repoHref);
---

<li
	class={cn(variant === "row" && "py-3.5 first:pt-0 last:pb-0", className)}
	data-testid={variant === "row" ? "project-row" : "featured-project-item"}
	{...attrs}
>
	{
		variant === "row" ? (
			<div class="flex items-start justify-between gap-4 sm:items-center">
				<div class="min-w-0 flex-1">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
						<TitleTag
							{...titleProps}
							class="text-foreground focus-visible:outline-ring inline-flex items-center gap-1.5 rounded text-sm font-medium underline-offset-4 hover:underline focus-visible:outline-2"
						>
							<Icon
								name="ph:git-branch"
								class="text-muted-foreground size-3.5 shrink-0"
								aria-hidden="true"
							/>
							<span>{project.text}</span>
						</TitleTag>

						{project.language && (
							<span class="text-muted-foreground inline-flex items-center gap-1.5 text-xs">
								<span
									class="size-2 shrink-0 rounded-full"
									style={{ backgroundColor: languageColor }}
									aria-hidden="true"
								/>
								{project.language}
							</span>
						)}

						{project.featured && (
							<span class="text-muted-foreground font-mono text-xs tracking-wide uppercase tabular-nums">
								Featured
							</span>
						)}

						{project.year && (
							<span class="text-muted-foreground font-mono text-xs tabular-nums">
								{project.year}
							</span>
						)}
					</div>

					{project.description && (
						<p class="text-muted-foreground mt-1 max-w-2xl text-xs leading-relaxed sm:text-sm">
							{project.description}
						</p>
					)}
				</div>

				<ProjectLinks {project} />
			</div>
		) : (
			<a
				href={href ?? "/projects"}
				target={href ? "_blank" : undefined}
				rel={href ? "noopener noreferrer" : undefined}
				class="group/project hover:bg-muted/40 focus-visible:ring-ring duration-fast -mx-3 block rounded-lg px-3 py-3 transition-all focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:scale-[0.99]"
			>
				<div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
					<div class="flex min-w-0 flex-col gap-0.5">
						<span class="text-foreground leading-snug font-medium">
							{project.text}
						</span>
						{showDescription && project.description && (
							<span class="text-muted-foreground line-clamp-2 text-sm leading-snug">
								{project.description}
							</span>
						)}
					</div>

					<div class="text-muted-foreground flex shrink-0 items-center gap-3 text-xs">
						{project.year && <span class="font-mono tabular-nums">{project.year}</span>}
						{isLive && (
							<Badge shape="pill" variant="outline">
								<Icon name="ph:arrow-up-right" aria-hidden="true" />
								Live
							</Badge>
						)}
						{hasRepo && (
							<Badge shape="pill" variant="outline">
								<Icon name="ph:github-logo" aria-hidden="true" />
								Repo
							</Badge>
						)}
					</div>
				</div>
			</a>
		)
	}
</li>
