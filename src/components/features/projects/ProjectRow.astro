---
import { Icon } from "astro-icon/components";
import type { Project } from "@/types";

interface Props {
	project: Project;
	featured?: boolean;
}

const { project, featured = false } = Astro.props;

const href = project.liveHref ?? project.repoHref ?? project.href;
const isLive = Boolean(project.liveHref);
const hasRepo = Boolean(project.repoHref);
---

<li class="py-4 first:pt-0 last:pb-0" data-testid="project-row">
	<div class="flex items-start gap-4 sm:items-center">
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
				{
					href ? (
						<a
							href={href}
							target="_blank"
							rel="noopener noreferrer"
							class="font-medium text-foreground hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring rounded"
						>
							{project.text}
						</a>
					) : (
						<span class="font-medium text-foreground">{project.text}</span>
					)
				}
				{
					featured && (
						<span class="text-muted-foreground font-mono text-xs uppercase tracking-wide tabular-nums">
							Featured
						</span>
					)
				}
				{
					project.year && (
						<span class="text-muted-foreground font-mono text-xs tabular-nums">
							{project.year}
						</span>
					)
				}
			</div>

			{
				project.description && (
					<p class="text-muted-foreground mt-1 max-w-2xl text-sm leading-snug">
						{project.description}
					</p>
				)
			}
		</div>

		<div class="flex shrink-0 items-center gap-2">
			{
				isLive && (
					<a
						href={project.liveHref}
						target="_blank"
						rel="noopener noreferrer"
						class="text-muted-foreground hover:text-foreground transition-colors p-1 focus-visible:outline-2 focus-visible:outline-ring rounded"
						aria-label={`Live site of ${project.text}`}
						title="Live"
					>
						<Icon
							name="ph:arrow-square-out"
							class="text-lg"
							aria-hidden="true"
						/>
					</a>
				)
			}
			{
				hasRepo && (
					<a
						href={project.repoHref}
						target="_blank"
						rel="noopener noreferrer"
						class="text-muted-foreground hover:text-foreground transition-colors p-1 focus-visible:outline-2 focus-visible:outline-ring rounded"
						aria-label={`Source code of ${project.text}`}
						title="Source code"
					>
						<Icon name="ph:github-logo" class="text-lg" aria-hidden="true" />
					</a>
				)
			}
		</div>
	</div>
</li>
