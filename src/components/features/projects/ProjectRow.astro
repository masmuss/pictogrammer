---
import type { Project } from "@/types";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
	project: Project;
	featured?: boolean;
}

const { project, featured = false } = Astro.props;

const href = project.liveHref ?? project.repoHref ?? project.href;
const TitleTag = href ? "a" : "span";
const titleProps = href
	? { href, target: "_blank", rel: "noopener noreferrer" }
	: {};
const titleClass = href
	? "font-medium text-foreground hover:underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-ring rounded"
	: "font-medium text-foreground";
---

<li class="py-4 first:pt-0 last:pb-0" data-testid="project-row">
	<div class="flex items-start gap-4 sm:items-center">
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<TitleTag {...titleProps} class={titleClass}>
					{project.text}
				</TitleTag>
				{
					featured && (
						<span class="text-muted-foreground font-mono text-xs uppercase tracking-wide tabular-nums">
							Featured
						</span>
					)
				}
				{
					project.year && (
						<span class="text-muted-foreground font-mono text-xs tabular-nums">
							{project.year}
						</span>
					)
				}
			</div>

			{
				project.description && (
					<p class="text-muted-foreground mt-1 max-w-2xl text-sm leading-snug">
						{project.description}
					</p>
				)
			}
		</div>

		<ProjectLinks {project} />
	</div>
</li>
