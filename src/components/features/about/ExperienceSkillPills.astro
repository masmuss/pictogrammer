---
import { Badge } from "@/components/ui/badge";
import { cn } from "@/lib/utils/tailwind";

interface Props {
	skills: string[];
	class?: string;
}

const { skills, class: className } = Astro.props;
---

<div class={cn("flex flex-wrap gap-2", className)}>
	{
		skills.map((skill) => (
			<Badge variant="outline" size="sm" class="uppercase tracking-wider">
				{skill}
			</Badge>
		))
	}
</div>
