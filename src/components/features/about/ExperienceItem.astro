---
import Heading from "@/components/ui/Heading.astro";
import { cn } from "@/lib/utils";
import { calculateDuration } from "@/lib/utils/date";
import type { Experience } from "@/types";

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
const duration = calculateDuration(experience.period);
---

<div class="transition-all" data-testid="experience-item">
	<div class="flex flex-row items-start gap-4 p-4">
		{
			experience.icon && (
				<div class="bg-muted border-border/50 mt-1 flex size-7 shrink-0 items-center justify-center rounded-lg border">
					<span
						class={cn("iconify", experience.icon, "text-foreground/80 size-4")}
					/>
				</div>
			)
		}
		<details class="group/details flex-1">
			<summary
				class="flex w-full cursor-pointer list-none items-center justify-between outline-none [&::-webkit-details-marker]:hidden"
			>
				<div class="flex items-start gap-x-3">
					<div class="flex flex-col gap-y-1.5">
						<Heading as="h4" weight="semibold">
							{experience.title}
						</Heading>
						<div
							class="text-muted-foreground flex flex-wrap items-center gap-x-2 font-mono text-xs tabular-nums"
						>
							<span class="capitalize">{experience.kind ?? "Professional"}</span
							>
							<span class="text-border">|</span>
							<span>{experience.period}</span>
							{
								duration && (
									<>
										<span class="text-border">|</span>
										<span>{duration}</span>
									</>
								)
							}
						</div>
					</div>
				</div>
				<span
					class="iconify ri--arrow-up-s-line text-muted-foreground size-5 rotate-180 transition-transform duration-300 group-open/details:rotate-0"
				></span>
			</summary>

			<div class="px-4 py-4">
				{
					experience.highlights.length > 0 && (
						<ul class="text-muted-foreground/90 list-disc space-y-2 text-sm">
							{experience.highlights.map((highlight) => (
								<li class="pl-1 leading-relaxed">{highlight}</li>
							))}
						</ul>
					)
				}
			</div>
		</details>
	</div>
	{
		experience.skills && experience.skills.length > 0 && (
			<div class="px-4 pb-4 pl-14">
				<div class="flex flex-wrap gap-2">
					{experience.skills.map((skill) => (
						<span class="bg-muted/50 border-border/40 text-muted-foreground hover:border-border/60 hover:text-foreground inline-flex items-center rounded-md border px-2 py-0.5 text-[10px] font-medium transition-colors select-none">
							{skill}
						</span>
					))}
				</div>
			</div>
		)
	}
</div>
