---
import { calculateDuration } from "@/lib/utils/date";
import type { Experience } from "@/types";
import ExperienceSkillPills from "./ExperienceSkillPills.astro";

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
const duration = calculateDuration(experience.period);
---

<div class="flex flex-col gap-y-2 py-5" data-testid="experience-item">
	<div class="flex flex-col gap-y-1.5">
		<div class="text-muted-foreground/80 font-mono text-xs tabular-nums">
			{experience.period}
			{duration && <span class="text-border/60 mx-2">-</span>}
			{duration}
		</div>

		<div class="flex flex-col gap-y-0.5">
			<p>
				<span class="font-semibold">{experience.title}</span> at {
					experience.company
				}
				{experience.location && <span> &middot; {experience.location}</span>}
			</p>
		</div>
	</div>

	{
		experience.highlights.length > 0 && (
			<ul class="text-muted-foreground flex flex-col gap-y-0.5 text-sm list-disc pl-4">
				{experience.highlights.map((highlight) => (
					<li class="leading-relaxed"> {highlight}</li>
				))}
			</ul>
		)
	}

	{
		experience.skills && experience.skills.length > 0 && (
			<ExperienceSkillPills skills={experience.skills} class="pt-1" />
		)
	}
</div>
