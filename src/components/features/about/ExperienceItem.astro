---
import Card from "@/components/ui/card/Card.astro";
import Heading from "@/components/ui/Heading.astro";
import type { Experience } from "@/types";

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
---

<Card variant="interactive" class="group/pos" data-testid="experience-item">
	<div class="flex flex-col gap-y-1.5">
		<div
			class="flex flex-col gap-y-0.5 sm:flex-row sm:items-center sm:justify-between"
		>
			<Heading as="h4" size="base" weight="medium" class="text-foreground">
				{experience.title}
			</Heading>
			<span class="text-muted-foreground font-mono text-xs tabular-nums">
				{experience.period}
			</span>
		</div>

		<p class="text-muted-foreground max-w-2xl text-sm leading-relaxed">
			{experience.summary ?? experience.highlights[0]}
		</p>

		{
			experience.skills && experience.skills.length > 0 && (
				<div class="flex flex-wrap gap-x-3 gap-y-1 pt-0.5">
					{experience.skills.map((skill) => (
						<span class="text-muted-foreground/90 font-mono text-[10px]">
							#{skill}
						</span>
					))}
				</div>
			)
		}

		{
			experience.highlights.length > 0 && (
				<details class="group/details mt-2">
					<summary class="text-accent-cta-text decoration-accent-cta/30 cursor-pointer list-none text-xs font-medium underline-offset-4 hover:underline [&::-webkit-details-marker]:hidden">
						<span class="flex items-center gap-1">
							<span>View details</span>
							<span class="iconify ri--arrow-down-s-line transition-transform duration-200 group-open/details:rotate-180" />
						</span>
					</summary>
					<ul class="text-muted-foreground mt-3 ml-4 list-disc space-y-2 text-sm">
						{experience.highlights.map((highlight) => (
							<li class="pl-1 leading-relaxed">{highlight}</li>
						))}
					</ul>
				</details>
			)
		}
	</div>
</Card>
