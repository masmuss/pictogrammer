---
import {
	fetchGitHubContributions,
	getTotalCount,
	groupByWeeks
} from "@/lib/github-calendar";

type CalendarTheme = {
	light: readonly [string, string, string, string, string];
	dark?: readonly [string, string, string, string, string];
};

interface Props {
	username: string;
	year?: number | "last";
	blockSize?: number;
	blockMargin?: number;
	showTotalCount?: boolean;
	showMonthLabels?: boolean;
	theme?: CalendarTheme;
}

const defaultTheme: CalendarTheme = {
	light: [
		"rgba(235, 237, 240, 0.4)",
		"#c6e48b",
		"#7bc96f",
		"#239a3b",
		"#196127"
	],
	dark: ["rgba(22, 27, 34, 0.8)", "#0e4429", "#006d32", "#26a641", "#39d353"]
};

const MONTH_LABELS = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec"
];

const {
	username,
	year = "last",
	blockSize = 16,
	blockMargin = 3,
	showTotalCount = true,
	showMonthLabels = true,
	theme = defaultTheme
} = Astro.props;

const activities = await fetchGitHubContributions(username, year);

if (!activities || activities.length === 0) {
	return null;
}

const weeks = groupByWeeks(activities);
const totalCount = getTotalCount(activities);
const yearLabel = year === "last" ? "the last year" : `${year}`;

const resolvedTheme: Required<CalendarTheme> = {
	light: theme.light,
	dark: theme.dark ?? theme.light
};

const firstActivityInWeek = (week: (typeof weeks)[number]) =>
	week.find((activity) => activity !== undefined);

const monthLabelWeeks = new Map<number, number>();
weeks.forEach((week, weekIndex) => {
	const activity = firstActivityInWeek(week);
	if (!activity) return;
	const month = new Date(`${activity.date}T00:00:00`).getMonth();
	if (!monthLabelWeeks.has(month)) {
		monthLabelWeeks.set(month, weekIndex);
	}
});

const sortedMonthEntries = Array.from(monthLabelWeeks.entries()).sort(
	([, a], [, b]) => a - b
);

const cell = blockSize + blockMargin;

const monthLabelEntries = sortedMonthEntries.map(
	([month, weekIndex], index, entries) => {
		const nextWeek = entries[index + 1]?.[1];
		const span = (nextWeek ?? weekIndex + 4) - weekIndex;
		return { month, centerX: (weekIndex + span / 2) * cell };
	}
);
const svgWidth = Math.max(blockSize, weeks.length * cell - blockMargin);
const svgHeight = 7 * cell - blockMargin;
const topPadding = showMonthLabels ? blockSize + 8 : 0;
---

<div
	class="w-full"
	style={{
		"--cl-0-light": resolvedTheme.light[0],
		"--cl-1-light": resolvedTheme.light[1],
		"--cl-2-light": resolvedTheme.light[2],
		"--cl-3-light": resolvedTheme.light[3],
		"--cl-4-light": resolvedTheme.light[4],
		"--cl-0-dark": resolvedTheme.dark[0],
		"--cl-1-dark": resolvedTheme.dark[1],
		"--cl-2-dark": resolvedTheme.dark[2],
		"--cl-3-dark": resolvedTheme.dark[3],
		"--cl-4-dark": resolvedTheme.dark[4]
	}}
>
	<div class="w-full min-w-0 overflow-x-auto pb-4" tabindex="0">
		<svg
			class="mb-2"
			width="100%"
			height="100%"
			viewBox={`0 0 ${svgWidth} ${svgHeight + topPadding}`}
			preserveAspectRatio="xMidYMid meet"
			xmlns="http://www.w3.org/2000/svg"
		>
			{
				showMonthLabels &&
					monthLabelEntries.map((entry) => (
						<text
							x={entry.centerX}
							y={blockSize * 0.7}
							class="month-label"
							font-size="11"
							font-weight="400"
							text-anchor="middle"
							dominant-baseline="middle"
						>
							{MONTH_LABELS[entry.month]}
						</text>
					))
			}

			{
				weeks.map((week, weekIndex) =>
					week.map((activity, dayIndex) => {
						const x = weekIndex * cell;
						const y = topPadding + dayIndex * cell;
						const level = activity?.level ?? 0;

						return (
							<rect
								x={x}
								y={y}
								width={blockSize}
								height={blockSize}
								rx="2"
								ry="2"
								data-level={level}
							/>
						);
					})
				)
			}
		</svg>
	</div>

	{
		showTotalCount && (
			<div class="text-muted-foreground mt-4 flex flex-col items-center justify-between gap-1 text-xs md:flex-row">
				<p>
					<strong>{totalCount}</strong> contributions in {yearLabel}
				</p>
				<div class="flex items-center gap-3">
					<span>Less</span>
					<div class="flex items-center space-x-1">
						{[0, 1, 2, 3, 4].map((level) => (
							<div class="legend-level" data-level={level} />
						))}
					</div>
					<span>More</span>
				</div>
			</div>
		)
	}
</div>

<style>
	svg {
		display: block;
		margin: 0 auto;
		min-width: 700px;
	}

	rect {
		stroke: transparent;
		stroke-width: 0;
	}

	rect[data-level="0"] {
		fill: var(--cl-0-light);
	}
	rect[data-level="1"] {
		fill: var(--cl-1-light);
	}
	rect[data-level="2"] {
		fill: var(--cl-2-light);
	}
	rect[data-level="3"] {
		fill: var(--cl-3-light);
	}
	rect[data-level="4"] {
		fill: var(--cl-4-light);
	}

	:global(.dark) rect[data-level="0"] {
		fill: var(--cl-0-dark);
	}
	:global(.dark) rect[data-level="1"] {
		fill: var(--cl-1-dark);
	}
	:global(.dark) rect[data-level="2"] {
		fill: var(--cl-2-dark);
	}
	:global(.dark) rect[data-level="3"] {
		fill: var(--cl-3-dark);
	}
	:global(.dark) rect[data-level="4"] {
		fill: var(--cl-4-dark);
	}

	.legend-level {
		height: 0.75rem;
		width: 0.75rem;
		border-radius: 0.25rem;
	}

	.legend-level[data-level="0"] {
		background-color: var(--cl-0-light);
	}
	.legend-level[data-level="1"] {
		background-color: var(--cl-1-light);
	}
	.legend-level[data-level="2"] {
		background-color: var(--cl-2-light);
	}
	.legend-level[data-level="3"] {
		background-color: var(--cl-3-light);
	}
	.legend-level[data-level="4"] {
		background-color: var(--cl-4-light);
	}

	:global(.dark) .legend-level[data-level="0"] {
		background-color: var(--cl-0-dark);
	}
	:global(.dark) .legend-level[data-level="1"] {
		background-color: var(--cl-1-dark);
	}
	:global(.dark) .legend-level[data-level="2"] {
		background-color: var(--cl-2-dark);
	}
	:global(.dark) .legend-level[data-level="3"] {
		background-color: var(--cl-3-dark);
	}
	:global(.dark) .legend-level[data-level="4"] {
		background-color: var(--cl-4-dark);
	}

	.month-label {
		fill: hsl(var(--foreground));
	}

	:global(html.theme-transitioning) rect {
		transition: none !important;
	}
</style>
