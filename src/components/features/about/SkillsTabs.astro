---
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { getSkillsTabs } from "@/lib/contents/skills";
import type { SkillCollection } from "@/types";

interface Props {
	collections: SkillCollection[];
	class?: string;
}

const { collections, class: className = "" } = Astro.props;
const tabs = getSkillsTabs(collections);
const defaultTab = tabs[0]?.id ?? "";
---

<Tabs defaultValue={defaultTab} class={className}>
	<TabsList variant="line-animated">
		{tabs.map((tab) => <TabsTrigger value={tab.id}>{tab.label}</TabsTrigger>)}
	</TabsList>

	{
		tabs.map((tab) => (
			<TabsContent value={tab.id}>
				<div class="flex flex-wrap gap-3">
					{tab.skills.map((skill) => (
						<Badge variant="outline" shape="pill" title={skill.description}>
							{skill.icon && <Icon name={`logos:${skill.icon}`} />}
							<span class="text-foreground/90 font-medium">{skill.name}</span>
						</Badge>
					))}
				</div>
			</TabsContent>
		))
	}
</Tabs>
