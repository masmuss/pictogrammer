---
import Button from "@/components/ui/Button.astro";
import { getSkillsTabs } from "@/lib/contents/skills";
import { cn } from "@/lib/utils";
import type { SkillCollection } from "@/types";

interface Props {
	collections: SkillCollection[];
	class?: string;
}

const { collections, class: className } = Astro.props;
const tabs = getSkillsTabs(collections);
---

<section class={className} data-skills-tabs>
	<div
		class="mb-4 flex flex-wrap gap-2"
		role="tablist"
		aria-label="Skill categories"
	>
		{
			tabs.map((tab, index) => (
				<Button
					as="button"
					id={`skills-tab-${tab.id}`}
					class="skills-tab cursor-pointer text-xs font-medium tracking-wide"
					style="tab"
					role="tab"
					data-tab={tab.id}
					aria-selected={index === 0 ? "true" : "false"}
					aria-controls={`skills-panel-${tab.id}`}
					data-active={index === 0 ? "true" : "false"}
					title={tab.label}
				/>
			))
		}
	</div>

	{
		tabs.map((tab, index) => (
			<div
				id={`skills-panel-${tab.id}`}
				class={cn("skills-panel", index !== 0 && "hidden")}
				role="tabpanel"
				aria-labelledby={`skills-tab-${tab.id}`}
				data-panel={tab.id}
			>
				<div class="flex flex-wrap gap-3">
					{tab.skills.map((skill) => (
						<div
							class="bg-card/50 border-border/50 hover:border-border hover:bg-card flex items-center gap-2.5 rounded-full border px-3 py-1.5 text-sm transition-colors select-none"
							title={skill.description}
						>
							{skill.icon && (
								<span class={cn("iconify-color", skill.icon, "size-4")} />
							)}
							<span class="text-foreground/90 font-medium">{skill.name}</span>
						</div>
					))}
				</div>
			</div>
		))
	}
</section>

<script>
	const tabRoots = document.querySelectorAll("[data-skills-tabs]");

	for (const root of tabRoots) {
		const tabButtons = root.querySelectorAll<HTMLButtonElement>(".skills-tab");
		const tabPanels = root.querySelectorAll<HTMLElement>(".skills-panel");

		for (const tab of tabButtons) {
			tab.addEventListener("click", () => {
				const id = tab.dataset.tab;
				if (!id) return;

				for (const item of tabButtons) {
					const isActive = item.dataset.tab === id;
					item.setAttribute("aria-selected", isActive ? "true" : "false");
					item.dataset.active = isActive ? "true" : "false";
				}

				for (const panel of tabPanels) {
					panel.classList.toggle("hidden", panel.dataset.panel !== id);
				}
			});
		}
	}
</script>
