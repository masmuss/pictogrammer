---
import { Image } from "astro:assets";
import Heading from "@/components/ui/Heading.astro";
import { cn } from "@/lib/utils";

interface Props {
	company: string;
	logo?: string;
	class?: string;
}

const { company, logo, class: className } = Astro.props;

const isHttp = logo?.startsWith("http");
const isIconify = logo?.startsWith("ri--");

const localImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/images/company/*.{jpeg,jpg,png,gif,svg,webp}"
);

let localImagePromise = null;
if (logo && !isHttp && !isIconify) {
	const cleanLogo = logo.replace(/^\//, "");
	const imagePath = `/src/assets/images/company/${cleanLogo}`;
	if (localImages[imagePath]) {
		localImagePromise = localImages[imagePath]();
	}
}

const localImageMetadata = localImagePromise
	? (await localImagePromise).default
	: null;
---

<div class={cn("flex items-center gap-x-3", className)}>
	{
		logo && (
			<div class="flex size-9 shrink-0 items-center justify-center overflow-hidden p-1">
				{isHttp ? (
					<img src={logo} alt={company} class="size-full object-contain" />
				) : localImageMetadata ? (
					<Image
						src={localImageMetadata}
						alt={company}
						class="size-full object-contain"
					/>
				) : (
					<span class={cn(logo, "size-full")} />
				)}
			</div>
		)
	}
	<Heading as="h3" size="lg" weight="semibold" class="text-foreground">
		{company}
	</Heading>
</div>
