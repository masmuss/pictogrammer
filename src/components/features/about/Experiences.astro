---
import Heading from "@/components/ui/Heading.astro";
import { getExperienceGroups } from "@/lib/contents/experiences";
import { cn } from "@/lib/utils";
import type { Experience } from "@/types";
import ExperienceItem from "./ExperienceItem.astro";

interface Props {
	experiences: Experience[];
}

const { experiences }: Props = Astro.props;

const groupedByCompany = getExperienceGroups(experiences);
---

<div class="flex flex-col gap-y-8">
	{
		groupedByCompany.map((organization) => (
			<div class="group/org flex flex-col gap-y-2">
				<div class="flex items-center gap-x-3">
					{organization.logo && (
						<div class="bg-card border-border/50 flex size-9 items-center justify-center overflow-hidden rounded-full border p-1 shadow-sm">
							<span class={cn("iconify", organization.logo, "size-full")} />
						</div>
					)}
					<Heading as="h3" size="lg" weight="semibold" class="text-foreground">
						{organization.company}
					</Heading>
				</div>

				{/* Positions */}
				<div class="flex flex-col gap-y-3">
					{organization.positions.map((exp) => (
						<ExperienceItem experience={exp} />
					))}
				</div>
			</div>
		))
	}
</div>
