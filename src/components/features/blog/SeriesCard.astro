---
import type { CollectionEntry } from "astro:content";
import {
	Card,
	CardDescription,
	CardHeader,
	CardTitle
} from "@/components/ui/card";

interface Props {
	series: CollectionEntry<"series">;
}

const { series } = Astro.props;
---

<a
	href={`/blog/series/${series.id}`}
	class="group/series block"
	data-testid="series-item"
>
	<Card class="flex h-full flex-col px-0 transition-shadow duration-200 hover:shadow-md">
		<CardHeader>
			<CardTitle class="group-hover/series:text-primary line-clamp-1 transition-colors">
				{series.data.title}
			</CardTitle>
			<CardDescription class="line-clamp-2 text-sm">
				{series.data.description}
			</CardDescription>
		</CardHeader>
	</Card>
</a>
