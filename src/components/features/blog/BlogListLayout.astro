---
import type { CollectionEntry } from "astro:content";
import BlogTabs from "@/components/features/blog/BlogTabs.astro";
import PostPreview from "@/components/features/blog/PostPreview.astro";
import Heading from "@/components/ui/Heading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostsByPath, groupPostsByYear } from "@/lib/contents";

interface Props {
	activeTab: "posts" | "notes" | "reflections";
	title: string;
	description: string;
	image?: { src: string; alt?: string };
	path?: string;
	emptyMessage?: string;
	posts?: CollectionEntry<"post">[];
}

const {
	activeTab,
	title,
	description,
	image,
	path,
	emptyMessage,
	posts: providedPosts
} = Astro.props;

const allPosts = providedPosts ?? (await getPostsByPath(path));
const postsByYear = groupPostsByYear(allPosts);
const empty = emptyMessage ?? `No ${title.toLowerCase()} yet.`;
---

<BaseLayout {title} {description} image={image} pageType="website">
  <div class="flex w-full flex-col gap-y-12">
    <Heading as="h1" class="sr-only">{title}</Heading>
    <div class="flex w-full flex-col">
      <BlogTabs {activeTab} />

      <div class="flex max-w-xl flex-col">
        {description && <p class="text-muted-foreground">{description}</p>}
      </div>
    </div>

    {allPosts.length === 0 && <p class="text-muted-foreground">{empty}</p>}

    {
      allPosts.length > 0 && (
        <div class="group/list flex flex-col gap-y-20">
          {[...postsByYear.entries()].map(([year, posts]) => (
            <section class="relative">
              <div class="pointer-events-none absolute -top-6 -left-2 text-8xl font-bold text-muted-foreground/10 select-none md:-top-8 md:-left-8 md:text-9xl">
                {year}
              </div>
              <ul class="relative flex flex-col">
                {posts.map((post) => (
                  <PostPreview
                    post={post}
                    showDescription
                    hasReadTime
                    showTags
                    readTimeStyle="short"
                  />
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    <slot name="after-posts" />
  </div>
</BaseLayout>
