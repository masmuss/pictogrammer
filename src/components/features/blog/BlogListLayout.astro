---
import type { CollectionEntry } from "astro:content";
import Heading from "@/components/common/Heading.astro";
import BlogTabs from "@/components/features/blog/BlogTabs.astro";
import PostPreview from "@/components/features/blog/PostPreview.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { groupPostsByYear } from "@/lib/contents";

interface Props {
	activeTab: "posts" | "notes" | "reflections";
	title: string;
	description: string;
	image?: { src: string; alt?: string };
	posts: CollectionEntry<"post">[];
	emptyMessage?: string;
}

const { activeTab, title, description, image, posts, emptyMessage } =
	Astro.props;

const postsByYear = groupPostsByYear(posts);
const empty = emptyMessage ?? `No ${title.toLowerCase()} yet.`;
---

<BaseLayout {title} {description} image={image} pageType="website">
	<div class="flex w-full flex-col gap-y-12">
		<Heading as="h1" class="sr-only">{title}</Heading>
		<div class="flex w-full flex-col">
			<BlogTabs {activeTab} />

			<div class="flex max-w-xl flex-col">
				{description && <p class="text-muted-foreground">{description}</p>}
			</div>
		</div>

		{posts.length === 0 && <p class="text-muted-foreground">{empty}</p>}

		{
			posts.length > 0 && (
				<div class="group/list flex flex-col gap-y-20">
					{[...postsByYear.entries()].map(([year, yearPosts]) => (
						<section class="relative">
							<div class="pointer-events-none absolute -top-6 -left-2 text-8xl font-bold text-muted-foreground/10 select-none md:-top-8 md:-left-8 md:text-9xl">
								{year}
							</div>
							<ul class="relative flex flex-col">
								{yearPosts.map((post) => (
									<PostPreview post={post} hasReadTime readTimeStyle="short" />
								))}
							</ul>
						</section>
					))}
				</div>
			)
		}
	</div>
</BaseLayout>
