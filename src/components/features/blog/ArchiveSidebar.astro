---
import type { YearGroup } from "@/lib/contents";
import { cn } from "@/lib/utils";

interface Props {
	archiveData: YearGroup[];
	class?: string;
}

const { archiveData, class: className } = Astro.props;
---

<aside class={cn("hidden w-48 lg:block", className)}>
  <nav class="sticky top-16 max-h-[calc(100vh-7rem)] overflow-y-auto text-sm">
    {
      archiveData.map(({ year, months, count }) => (
        <div class="flex flex-col gap-y-1 pb-4 last:pb-0">
          <a
            href={`#year-${year}`}
            class="text-foreground hover:text-primary flex items-baseline justify-between font-medium transition-colors"
          >
            <span>{year}</span>
            <span class="text-muted-foreground/50 tabular-nums text-xs">
              {count}
            </span>
          </a>
          <ul class="flex flex-col">
            {months.map(({ month, monthName, posts }) => (
              <li>
                <a
                  href={`#month-${year}-${month}`}
                  class="text-muted-foreground hover:text-foreground flex items-baseline justify-between pl-4 transition-colors leading-relaxed"
                >
                  <span>{monthName}</span>
                  <span class="text-muted-foreground/50 tabular-nums text-xs">
                    {posts.length}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
