---
import PostMetadata from "@/components/common/PostMetadata.astro";
import { Card, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import Heading from "@/components/ui/Heading.astro";
import { getPostUrl } from "@/lib/utils";
import type { CollectionPosts } from "@/types";

interface Props {
	relatedPosts: CollectionPosts[];
}

const { relatedPosts } = Astro.props;
---

{
	relatedPosts.length > 0 && (
		<div class="border-border/40 mt-12 flex flex-col gap-y-4 border-t pt-8">
			<Heading
				as="h2"
				size="sm"
				weight="medium"
				class="text-muted-foreground mb-2 tracking-wider uppercase"
			>
				Related Posts
			</Heading>
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
				{relatedPosts.map((post) => (
					<Card as="a" href={getPostUrl(post)} reload>
						<CardHeader>
							<CardTitle>{post.data.title}</CardTitle>
						</CardHeader>
						<CardFooter>
							<PostMetadata post={post} readTimeStyle="long" />
						</CardFooter>
					</Card>
				))}
			</div>
		</div>
	)
}
