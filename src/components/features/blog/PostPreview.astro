---
import type { CollectionEntry } from "astro:content";
import PostMetadata from "@/components/common/PostMetadata.astro";
import DraftBadge from "@/components/features/blog/DraftBadge.astro";
import { getPostUrl } from "@/lib/utils/post-route";

type Props = {
	post: CollectionEntry<"post">;
	showDescription?: boolean;
	showTags?: boolean;
	clampTitle?: boolean;
	hasReadTime?: boolean;
	readTimeStyle?: "short" | "long";
};

const {
	post,
	showDescription,
	showTags = false,
	clampTitle = true,
	hasReadTime = false,
	readTimeStyle = "short"
} = Astro.props;

const titleClasses = clampTitle
	? ["font-medium transition-colors", "sm:line-clamp-1"]
	: ["font-medium transition-colors"];
const visibleTags = showTags ? post.data.tags : [];
---

<li
	data-testid="post-preview"
	class="group-hover/list:opacity-50 hover:opacity-100 transition-opacity duration-base"
>
	<a
		href={getPostUrl(post)}
		class="scroll-reveal group/post block -mx-3 rounded-lg px-3 py-3 hover:bg-muted/40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none focus-visible:ring-offset-2 transition-all duration-fast"
	>
		<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
			<span class:list={titleClasses} transition:name={`title-${post.id}`}>
				{post.data.title}
				{post.data.draft && <DraftBadge />}
			</span>
			<span class="text-muted-foreground shrink-0 text-sm">
				<PostMetadata {post} {hasReadTime} {readTimeStyle} />
			</span>
		</div>

		{
			showDescription && (
				<p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground mt-1">
					{post.data.description}
				</p>
			)
		}

		{
			visibleTags.length > 0 && (
				<div
					class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground"
					aria-label="tags"
				>
					{visibleTags.map((tag) => (
						<span>{tag}</span>
					))}
				</div>
			)
		}
	</a>
</li>
