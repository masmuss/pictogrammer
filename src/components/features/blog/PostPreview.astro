---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostMetadata from "@/components/common/PostMetadata.astro";
import DraftBadge from "@/components/features/blog/DraftBadge.astro";
import { getPostUrl } from "@/lib/utils";

type Props = {
	post: CollectionEntry<"post">;
	showDescription?: boolean;
	showTags?: boolean;
	clampTitle?: boolean;
	hasReadTime?: boolean;
	readTimeStyle?: "short" | "long";
};

const {
	post,
	showDescription,
	showTags = false,
	clampTitle = true,
	hasReadTime = false,
	readTimeStyle = "short"
} = Astro.props;

const titleClasses = clampTitle
	? ["font-medium transition-colors", "sm:line-clamp-1"]
	: ["font-medium transition-colors"];
const visibleTags = showTags ? post.data.tags : [];
---

<li
	data-testid="post-preview"
	class="duration-base transition-opacity group-hover/list:opacity-50 hover:opacity-100"
>
	<a
		href={getPostUrl(post)}
		class="scroll-reveal group/post hover:bg-muted/40 focus-visible:ring-ring duration-fast -mx-3 block rounded-lg px-3 py-3 transition-all focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
	>
		<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4 md:justify-between">
			<span
				class="flex min-w-0 items-center"
				transition:name={`title-${post.id}`}
			>
				<span class:list={titleClasses}>{post.data.title}</span>
				{post.data.draft && <DraftBadge />}
				{post.data.externalUrl && (
					<span class="ml-1.5 inline-flex shrink-0 items-center">
						<Icon
							name="ph:arrow-up-right"
							class="text-muted-foreground size-4 transition-transform duration-200 group-hover/post:translate-x-0.5 group-hover/post:-translate-y-0.5"
							aria-hidden="true"
							focusable="false"
						/>
						<span class="sr-only">External post</span>
					</span>
				)}
			</span>
			<span class="text-muted-foreground shrink-0 text-sm">
				<PostMetadata {post} {hasReadTime} {readTimeStyle} />
			</span>
		</div>

		{showDescription && (
			<p class="text-muted-foreground mt-1 line-clamp-2 text-sm leading-relaxed">
				{post.data.description}
			</p>
		)}

		{visibleTags.length > 0 && (
			<div class="text-muted-foreground mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
				{visibleTags.map((tag) => (
					<span>{tag}</span>
				))}
			</div>
		)}
	</a>
</li>
