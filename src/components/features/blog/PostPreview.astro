---
import type { CollectionEntry } from "astro:content";
import PostMetadata from "@/components/common/PostMetadata.astro";
import DraftBadge from "@/components/features/blog/DraftBadge.astro";
import { getPostUrl } from "@/lib/utils/post-route";

type Props = {
	post: CollectionEntry<"post">;
	showDescription?: boolean;
	showTags?: boolean;
	clampTitle?: boolean;
	hasReadTime?: boolean;
	readTimeStyle?: "short" | "long";
};

const {
	post,
	showDescription,
	showTags = false,
	clampTitle = true,
	hasReadTime = false,
	readTimeStyle = "short"
} = Astro.props;

const titleClasses = clampTitle
	? ["font-medium transition-colors", "sm:line-clamp-1"]
	: ["font-medium transition-colors"];
const visibleTags = showTags ? post.data.tags : [];
---

<li
	data-testid="post-preview"
	class="duration-base transition-opacity group-hover/list:opacity-50 hover:opacity-100"
>
	<a
		href={getPostUrl(post)}
		class="scroll-reveal group/post hover:bg-muted/40 focus-visible:ring-ring duration-fast -mx-3 block rounded-lg px-3 py-3 transition-all focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
	>
		<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
			<span class:list={titleClasses} transition:name={`title-${post.id}`}>
				{post.data.title}
				{post.data.draft && <DraftBadge />}
			</span>
			<span class="text-muted-foreground shrink-0 text-sm">
				<PostMetadata {post} {hasReadTime} {readTimeStyle} />
			</span>
		</div>

		{showDescription && (
			<p class="text-muted-foreground mt-1 line-clamp-2 text-sm leading-relaxed">
				{post.data.description}
			</p>
		)}

		{visibleTags.length > 0 && (
			<div class="text-muted-foreground mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
				{visibleTags.map((tag) => (
					<span>{tag}</span>
				))}
			</div>
		)}
	</a>
</li>
