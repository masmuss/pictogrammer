---
interface Props {
	tags: string[];
}

const { tags }: Props = Astro.props;
---

<div class="flex flex-wrap items-center justify-start gap-x-4 gap-y-1">
	{
		tags.map((tag) => (
			<a
				href={`/tags/${tag}`}
				class="text-muted-foreground hover:text-foreground py-1 text-xs transition-colors"
			>
				# {tag}
			</a>
		))
	}
</div>
