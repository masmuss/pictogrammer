---
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/ui/badge";
---

<Badge
	variant="outline"
	size="sm"
	shape="pill"
	class="ml-1.5 align-middle text-flexoki-orange-600 bg-[color-mix(in_oklch,var(--color-flexoki-orange-600)_10%,transparent)] border-[color-mix(in_oklch,var(--color-flexoki-orange-600)_30%,transparent)] dark:text-flexoki-orange-400 dark:bg-[color-mix(in_oklch,var(--color-flexoki-orange-400)_14%,transparent)] dark:border-[color-mix(in_oklch,var(--color-flexoki-orange-400)_35%,transparent)]"
>
	<Icon name="ph:pencil-simple-line" />
	Draft
</Badge>
