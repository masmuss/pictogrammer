---
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/ui/badge";
---

<Badge
	variant="outline"
	size="sm"
	shape="pill"
	class="text-flexoki-orange-600 dark:text-flexoki-orange-400 ml-1.5 border-[color-mix(in_oklch,var(--color-flexoki-orange-600)_30%,transparent)] bg-[color-mix(in_oklch,var(--color-flexoki-orange-600)_10%,transparent)] align-middle dark:border-[color-mix(in_oklch,var(--color-flexoki-orange-400)_35%,transparent)] dark:bg-[color-mix(in_oklch,var(--color-flexoki-orange-400)_14%,transparent)]"
>
	<Icon name="ph:pencil-simple-line" />
	Draft
</Badge>
