---
import type { CollectionEntry } from "astro:content";
import PostMetadata from "@/components/common/PostMetadata.astro";
import Heading from "@/components/ui/Heading.astro";
import siteConfig from "@/config/site-config";
import PostImage from "./PostImage.astro";
import PostTags from "./PostTags.astro";

interface Props {
	content: CollectionEntry<"post">;
	coverImageResolved?: {
		src: string;
		alt: string;
	};
}

const { content, coverImageResolved }: Props = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long"
};
---

<header class="flex flex-col justify-start gap-4">
	<div class="flex flex-col gap-4 md:gap-6">
		{content.data.tags.length > 0 && <PostTags tags={content.data.tags} />}
		<Heading
			as="h1"
			class="leading-tight text-2xl md:text-3xl"
			transition:name={`title-${content.id}`}
		>
			{content.data.title}
		</Heading>

		<div class="text-muted-foreground text-left gap-2 text-sm">
			<span class="sr-only">{siteConfig.author}</span>
			<PostMetadata
				post={content}
				dateTimeOptions={dateTimeOptions}
				hasReadTime
				readTimeStyle="long"
			/>
		</div>
	</div>
</header>

<>
	{
		content.data.coverImage && coverImageResolved && (
			<PostImage
				src={coverImageResolved.src}
				alt={coverImageResolved.alt || content.data.title}
			/>
		)
	}
</>
