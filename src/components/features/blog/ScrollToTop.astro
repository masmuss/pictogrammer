---
import { Icon } from "astro-icon/components";
---

<a
	aria-label="Back to Top"
	href="#"
	class="back-to-top bg-card text-foreground border-border hover:border-border/75 duration-slow pointer-events-none fixed inset-e-12 bottom-16 z-50 flex h-12 w-12 items-center justify-center rounded-md border text-2xl opacity-0 shadow-md transition-all md:inset-e-16"
	id="to-top-btn"
>
	<Icon name="ph:arrow-up" />
</a>

<script>
	const setupBackToTop = () => {
		const button = document.querySelector("#to-top-btn");
		if (!(button instanceof HTMLElement) || button.dataset.initialized) return;

		button.dataset.initialized = "true";
		const updateVisibility = () => {
			button.classList.toggle("is-visible", window.scrollY > 150);
		};

		window.addEventListener("scroll", updateVisibility, { passive: true });
		updateVisibility();
	};

	document.addEventListener("astro:page-load", setupBackToTop);
	setupBackToTop();
</script>

<style>
	.back-to-top {
		transform: translateY(28px);
	}

	.back-to-top.is-visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}
</style>
