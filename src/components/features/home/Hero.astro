---
import SocialLinks from "@/components/common/SocialLinks.astro";
import Button from "@/components/ui/Button.astro";

import siteConfig from "@/config/site-config";
import { getCurrentRole } from "@/lib/contents";

const currentRole = await getCurrentRole();
---

<div class="flex flex-col gap-y-6">
	<div class="flex flex-col gap-y-4">
		<p class="text-muted-foreground max-w-lg leading-relaxed">
			Full-stack developer & photographer based in Surabaya. Building web
			experiences and capturing moments through a lens.
		</p>
		{
			currentRole && (
				<div class="text-muted-foreground flex items-center gap-2 text-xs md:text-sm">
					<span class="iconify ri--briefcase-4-line text-primary hidden md:block" />
					<span>
						Currently <strong>{currentRole.title}</strong> at{" "}
						<strong>{currentRole.company}</strong>
					</span>
				</div>
			)
		}
	</div>
	<div class="flex flex-wrap items-center gap-4">
		{
			siteConfig.cvLink && (
				<Button href={siteConfig.cvLink} variant="outline">
					Resume
					<span slot="icon-after" class="iconify ri--file-download-line" />
				</Button>
			)
		}
		<SocialLinks variant="icon" showEmail />
	</div>
</div>
