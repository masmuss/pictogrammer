---
import { Icon } from "astro-icon/components";
import Heading from "@/components/common/Heading.astro";
import SocialLinks from "@/components/common/SocialLinks.astro";
import Button from "@/components/ui/button/Button.astro";

import siteConfig from "@/config/site";
---

<div class="flex max-w-4xl flex-col gap-y-6">
	<Heading as="h1" size="2xl" weight="semibold">
		Ahmad Musafir Khoirul Fattah
	</Heading>
	<p class="text-muted-foreground max-w-xl leading-relaxed">
		Backend-focused full-stack developer based in Surabaya. I build web
		applications, APIs, and IoT-enabled tools, then write about the work.
	</p>
	<div class="flex flex-wrap items-center gap-4">
  		<Button as="a" href="/projects">
 			View selected projects
 			<Icon name="ph:arrow-right" aria-hidden="true" />
  		</Button>
  		{siteConfig.cvLink && (
 			<Button as="a" href={siteConfig.cvLink} variant="outline">
				Resume
				<Icon name="ph:file-arrow-down" />
 			</Button>
  		)}
		<SocialLinks variant="icon" showEmail />
	</div>
</div>
