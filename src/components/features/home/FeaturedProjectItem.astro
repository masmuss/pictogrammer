---
import { Icon } from "astro-icon/components";
import { Badge } from "@/components/ui/badge";
import { cn } from "@/lib/utils";
import type { Project } from "@/types";

interface Props {
	project: Project;
	showDescription?: boolean;
}

const { project, showDescription } = Astro.props;

const href = project.liveHref ?? project.repoHref;
const isLive = Boolean(project.liveHref);
const hasRepo = Boolean(project.repoHref);

const linkAttrs = href
	? {
			href,
			target: "_blank",
			rel: "noopener noreferrer"
		}
	: {
			href: "/projects",
			target: undefined,
			rel: undefined
		};
---

<a
	href={linkAttrs.href}
	{...linkAttrs}
	class={cn(
		"group/project -mx-3 block rounded-lg px-3 py-3",
		"hover:bg-muted/40 active:scale-[0.99]",
		"focus-visible:ring-ring focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none",
		"duration-fast transition-all"
	)}
	data-testid="featured-project-item"
>
	<div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
		<div class="flex min-w-0 flex-col gap-0.5">
			<span class="text-foreground leading-snug font-medium">
				{project.text}
			</span>
			{showDescription && project.description && (
				<span class="text-muted-foreground line-clamp-2 text-sm leading-snug">
					{project.description}
				</span>
			)}
		</div>

		<div class="text-muted-foreground flex shrink-0 items-center gap-3 text-xs">
			{project.year && <span class="font-mono tabular-nums">{project.year}</span>}
			{isLive && (
				<Badge shape="pill" variant="outline">
					<Icon name="ph:arrow-up-right" aria-hidden="true" />
					Live
				</Badge>
			)}
			{hasRepo && (
				<Badge shape="pill" variant="outline">
					<Icon name="ph:github-logo" aria-hidden="true" />
					Repo
				</Badge>
			)}
		</div>
	</div>
</a>
