---
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/features/blog/PostPreview.astro";
import { cn } from "@/lib/utils";
import type { CollectionPosts } from "@/types";

interface Props {
	posts: CollectionPosts[];
}

const { posts }: Props = Astro.props;
---

{posts.length > 0 ? (
	<Fragment>
		<ul class="divide-border/60 flex max-w-4xl flex-col divide-y">
			{posts.map((p) => (
				<PostPreview post={p} hasReadTime />
			))}
		</ul>
		<div class="flex w-full items-end justify-start">
			<a
				href="/blog"
				class={cn(
					"group/see-all inline-flex items-center gap-1.5",
					"duration-fast text-sm transition-colors",
					"underline-offset-4 hover:underline",
					"focus-visible:ring-2 focus-visible:outline-none",
					"focus-visible:ring-ring rounded focus-visible:ring-offset-2",
					"text-accent-cta-text"
				)}
			>
				<span>See all posts</span>
				<Icon name="ph:arrow-right" />
			</a>
		</div>
	</Fragment>
) : (
	<p class="text-muted-foreground text-sm" data-testid="latest-posts-empty">
		No posts yet. New writing will appear here once published.
	</p>
)}
