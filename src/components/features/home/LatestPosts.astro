---
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/features/blog/PostPreview.astro";
import { cn } from "@/lib/utils/tailwind";
import type { CollectionPosts } from "@/types";

interface Props {
	posts: CollectionPosts[];
}

const { posts }: Props = Astro.props;
---

{
	posts.length > 0 && (
		<Fragment>
			<ul class="flex flex-col">
				{posts.map((p) => (
					<PostPreview post={p} hasReadTime />
				))}
			</ul>
			<div class="flex w-full items-end justify-end">
				<a
					href="/blog"
					class={cn(
						"group/seeall inline-flex items-center gap-1.5",
						"duration-fast text-sm transition-colors",
						"focus-visible:ring-2 focus-visible:outline-none",
						"focus-visible:ring-ring rounded focus-visible:ring-offset-2",
						"text-accent-cta-text"
					)}
				>
					<span>See all posts</span>
					<Icon
						name="ph:arrow-right"
						class="duration-fast transition-transform group-hover/seeall:translate-x-1"
					/>
				</a>
			</div>
		</Fragment>
	)
}
