---
import { getAllProjects } from "@/lib/constants/projects";
import { cn } from "@/lib/utils";
import FeaturedProjectItem from "./FeaturedProjectItem.astro";

interface Props {
	max?: number;
}

const { max = 3 } = Astro.props;

const allProjects = await getAllProjects();
const featured = allProjects
	.flatMap((c) => c.projects)
	.filter((p) => p.featured)
	.slice(0, max);
---

{
	featured.length > 0 && (
		<div class="flex flex-col gap-y-1">
			{featured.map((project) => (
				<FeaturedProjectItem project={project} />
			))}

			{/* See all projects link */}
			<div class="mt-2 flex w-full justify-end">
				<a
					href="/projects"
					class={cn(
						"group/seeall inline-flex items-center gap-1.5",
						"duration-fast text-sm transition-colors",
						"focus-visible:ring-2 focus-visible:outline-none",
						"focus-visible:ring-ring rounded focus-visible:ring-offset-2",
						"text-accent-cta-text"
					)}
				>
					<span>See all projects</span>
					<span
						class="iconify ri--arrow-right-long-line duration-base transition-transform group-hover/seeall:translate-x-1"
						aria-hidden="true"
					/>
				</a>
			</div>
		</div>
	)
}
