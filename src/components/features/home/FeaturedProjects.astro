---
import SectionLink from "@/components/common/SectionLink.astro";
import type { Project } from "@/types";
import FeaturedProjectItem from "./FeaturedProjectItem.astro";

interface Props {
	projects: Project[];
	max?: number;
}

const { projects, max = 5 } = Astro.props;
const displayed = projects.slice(0, max);
---

{displayed.length > 0 ? (
	<Fragment>
		<div
			class="divide-border/60 flex max-w-4xl flex-col divide-y"
			data-testid="featured-project-list"
		>
			{displayed.map((project, index) => (
				<div
					data-fade-up="true"
					class="translate-y-4 opacity-0 transition-[opacity,transform] ease-out"
					style={`transition-delay: ${index * 80}ms; transition-duration: var(--duration-slower);`}
				>
					<FeaturedProjectItem project={project} showDescription />
				</div>
			))}
		</div>

		<SectionLink href="/projects" text="See all projects" />
	</Fragment>
) : (
	<p class="text-muted-foreground text-sm" data-testid="featured-project-empty">
		No featured projects yet. New work will appear here once published.
	</p>
)}
