---
import type { CollectionEntry } from "astro:content";
import { Container } from "@/components/common/primitives";
import BlogHero from "@/components/features/blog/Hero.astro";
import PostSeries from "@/components/features/blog/PostSeries.astro";
import ScrollToTop from "@/components/features/blog/ScrollToTop.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSeriesById, getSeriesForPost } from "@/lib/contents";
import { getPostOgImagePath, getPostUrl } from "@/lib/utils/post-route";

interface Props {
	post: CollectionEntry<"post">;
	hasGithubCard?: boolean;
}

const { post, hasGithubCard = false } = Astro.props;
const {
	data: { description, title, date, updatedDate, coverImage }
} = post;

const seriesId = getSeriesForPost(post);
const series = seriesId ? await getSeriesById(seriesId) : null;

const breadcrumbs: Array<{ name: string; item: string }> = [
	{ name: "Home", item: new URL("/", Astro.site).href },
	{ name: "Blog", item: new URL("/blog", Astro.site).href },
	{
		name: title,
		item: new URL(getPostUrl(post), Astro.site).href
	}
];

const socialImage = {
	src: new URL(getPostOgImagePath(post), Astro.url).href,
	alt: title
};
const coverImageResolved = coverImage
	? {
			src:
				typeof coverImage.src === "string"
					? coverImage.src
					: coverImage.src.src,
			alt: coverImage.alt
		}
	: undefined;
const ogImage = coverImageResolved || socialImage;
---

<BaseLayout
	title={title}
	description={description}
	date={date}
	updatedDate={updatedDate}
	pageType="article"
	image={ogImage}
	breadcrumbs={breadcrumbs}
>
	<div class="w-full">
		<Container class="ms-0 ps-0 sm:ps-0 md:ps-0">
			<div class="max-w-3xl">
				<article data-pagefind-body>
					<div id="blog-hero">
						<BlogHero content={post} coverImageResolved={coverImageResolved} />
					</div>
					{series && <PostSeries {series} {seriesId} />}

					<slot />
				</article>
			</div>
		</Container>

		<ScrollToTop />
	</div>
	{hasGithubCard && <script async is:inline src="/github-card.js" />}
</BaseLayout>
