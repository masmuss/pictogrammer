---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BlogHero from "@/components/features/blog/Hero.astro";
import PostSeries from "@/components/features/blog/PostSeries.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSeriesById, getSeriesForPost } from "@/lib/contents";
import { getPostOgImagePath } from "@/lib/utils/post-route";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	data: { description, title, date, updatedDate, coverImage }
} = post;

const seriesId = getSeriesForPost(post);
const series = seriesId ? await getSeriesById(seriesId) : null;

const socialImage = {
	src: new URL(getPostOgImagePath(post), Astro.url).href,
	alt: title
};
const coverImageResolved = coverImage
	? {
			src:
				typeof coverImage.src === "string"
					? coverImage.src
					: coverImage.src.src,
			alt: coverImage.alt
		}
	: undefined;
const ogImage = coverImageResolved || socialImage;
---

<BaseLayout
  title={title}
  description={description}
  date={date}
  updatedDate={updatedDate}
  pageType="article"
  image={ogImage}
  wide
>
  <div class="w-full">
    <div
      class="grid grid-cols-1 gap-8 xl:grid-cols-[0.4fr_1fr_0.5fr] xl:gap-10"
    >
      <aside class="hidden xl:block" aria-label="Table of Contents">
        <div class="sticky top-28 max-h-[calc(100vh-8rem)]">
          <slot name="toc" />
        </div>
      </aside>

      <div class="min-w-0 space-y-12">
        <article class="max-w-3xl mx-auto">
          <div data-pagefind-body>
            <div id="blog-hero">
              <BlogHero content={post} coverImageResolved={coverImageResolved} />
            </div>
            {series && <PostSeries {series} {seriesId} />}
          </div>

          <div class="xl:hidden">
            <slot name="toc-mobile" />
          </div>

          <slot />
        </article>

        <slot name="footer" />
      </div>

      <aside class="hidden xl:block" aria-label="Share this post">
        <div class="sticky top-1/3">
          <slot name="share" />
        </div>
      </aside>
    </div>

    <a
      aria-label="Back to Top"
      href="#"
      class="back-to-top bg-muted hover:border-border/75 duration-slow fixed inset-e-12 bottom-16 z-50 flex h-12 w-12 items-center justify-center rounded-lg text-2xl opacity-0 transition-all md:inset-e-16"
      id="to-top-btn"
    >
      <Icon name="ph:arrow-up"/>
    </a>
  </div>
  <script async is:inline src="/github-card.js"></script>
</BaseLayout>

<style>
  @supports (animation-timeline: scroll()) {
    .back-to-top {
      animation: reveal-back-to-top linear forwards;
      animation-timeline: scroll(root);
      animation-range: 150px 500px;
    }
  }

  @keyframes reveal-back-to-top {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Fallback: always visible when scroll-driven animations unsupported */
  @supports not (animation-timeline: scroll()) {
    .back-to-top {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
