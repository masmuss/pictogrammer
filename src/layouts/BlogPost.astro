---
import type { CollectionEntry } from "astro:content";
import BlogHero from "@/components/features/blog/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSeriesById, getSeriesForPost } from "@/lib/contents";
import { getPostOgImagePath } from "@/lib/utils/post-route";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	data: { description, title, date, updatedDate, coverImage }
} = post;

const seriesId = getSeriesForPost(post);
const series = seriesId ? await getSeriesById(seriesId) : null;

const socialImage = {
	src: new URL(getPostOgImagePath(post), Astro.url).href,
	alt: title
};
const coverImageResolved = coverImage
	? {
			src:
				typeof coverImage.src === "string"
					? coverImage.src
					: coverImage.src.src,
			alt: coverImage.alt
		}
	: undefined;
const ogImage = coverImageResolved || socialImage;
---

<BaseLayout
	title={title}
	description={description}
	date={date}
	updatedDate={updatedDate}
	pageType="article"
	image={ogImage}
>
	<div class="w-full space-y-6">
		<div class="w-full md:flex md:items-center md:justify-center">
			<article class="max-w-3xl grow wrap-break-word" data-pagefind-body>
				<div id="blog-hero">
					<BlogHero content={post} coverImageResolved={coverImageResolved} />
				</div>
				{
					series && (
						<div class="mt-4 mb-8 p-4 text-center">
							<p class="text-muted-foreground text-sm">
								Part of the series:{" "}
								<a
									href={`/blog/series/${seriesId}`}
									class="text-foreground font-medium underline underline-offset-4 hover:opacity-75"
								>
									{series.data.title}
								</a>
							</p>
						</div>
					)
				}
				<div>
					<slot />
				</div>
			</article>
		</div>
		<a
			aria-label="Back to Top"
			href="#"
			class="back-to-top bg-muted hover:border-border/75 duration-slow fixed inset-e-12 bottom-16 z-90 flex h-12 w-12 items-center justify-center rounded-full text-2xl opacity-0 transition-all md:inset-e-16"
			id="to-top-btn"
		>
			<span class="iconify ri--arrow-up-line"></span>
		</a>
	</div>
</BaseLayout>

<style>
	@supports (animation-timeline: scroll()) {
		.back-to-top {
			animation: reveal-back-to-top linear forwards;
			animation-timeline: scroll(root);
			animation-range: 150px 500px;
		}
	}

	@keyframes reveal-back-to-top {
		from {
			opacity: 0;
			transform: translateY(28px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Fallback: always visible when scroll-driven animations unsupported */
	@supports not (animation-timeline: scroll()) {
		.back-to-top {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
