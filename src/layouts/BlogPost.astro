---
import type { CollectionEntry } from "astro:content";
import BlogHero from "@/components/features/blog/Hero.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSeriesById, getSeriesForPost } from "@/lib/contents";
import { getPostOgImagePath } from "@/lib/utils/post-route";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	data: { description, title, date, updatedDate, coverImage }
} = post;

const seriesId = getSeriesForPost(post);
const series = seriesId ? await getSeriesById(seriesId) : null;

const socialImage = {
	src: new URL(getPostOgImagePath(post), Astro.url).href,
	alt: title
};
const coverImageResolved = coverImage
	? {
			src:
				typeof coverImage.src === "string"
					? coverImage.src
					: coverImage.src.src,
			alt: coverImage.alt
		}
	: undefined;
const coverImageForMeta = coverImage
	? {
			src:
				typeof coverImage.src === "string"
					? coverImage.src
					: coverImage.src.src,
			alt: coverImage.alt
		}
	: undefined;
const ogImage = coverImageForMeta || socialImage;
---

<BaseLayout
	title={title}
	description={description}
	date={date}
	updatedDate={updatedDate}
	pageType="article"
	image={ogImage}
>
	<div class="w-full space-y-6">
		<div class="w-full md:flex md:items-center md:justify-center">
			<article class="max-w-3xl grow wrap-break-word" data-pagefind-body>
				<div id="blog-hero">
					<BlogHero content={post} coverImageResolved={coverImageResolved} />
				</div>
				{
					series && (
						<div class="mt-4 mb-8 p-4 text-center">
							<p class="text-muted-foreground text-sm">
								Part of the series:{" "}
								<a
									href={`/blog/series/${seriesId}`}
									class="text-foreground font-medium underline underline-offset-4 hover:opacity-75"
								>
									{series.data.title}
								</a>
							</p>
						</div>
					)
				}
				<div>
					<slot />
				</div>
			</article>
		</div>
		<button
			aria-label="Back to Top"
			class="bg-muted hover:border-border/75 fixed inset-e-12 bottom-16 z-90 flex h-12 w-12 translate-y-28 items-center justify-center rounded-full text-2xl opacity-0 transition-all duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 md:inset-e-16"
			data-show="false"
			id="to-top-btn"
		>
			<span class="iconify ri--arrow-up-line"></span>
		</button>
	</div>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;
	if (!scrollBtn || !targetHeader) {
		console.warn("Back to top controls are unavailable on this page.");
	} else {
		function callback(entries: IntersectionObserverEntry[]) {
			entries.forEach((entry) => {
				scrollBtn.dataset.show = (!entry.isIntersecting).toString();
			});
		}

		scrollBtn.addEventListener("click", () => {
			document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
		});

		const observer = new IntersectionObserver(callback);
		observer.observe(targetHeader);
	}
</script>
