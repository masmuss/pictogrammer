{
	"name": "pictogrammer",
	"version": "1.37.0",
	"type": "module",
	"description": "Personal website and blog of Khoirul Fattah — full-stack projects, technical writing, and photography.",
	"homepage": "https://khoirul.me",
	"repository": {
		"type": "git",
		"url": "https://github.com/masmuss/pictogrammer"
	},
	"license": "MIT",
	"author": {
		"name": "Ahmad Musafir Khoirul Fattah",
		"email": "hello@khoirul.me",
		"url": "https://khoirul.me"
	},
	"keywords": [
		"personal-website",
		"portfolio",
		"blog",
		"astro",
		"tailwindcss",
		"svelte"
	],
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"lint:ci": "bunx --bun @biomejs/biome ci",
		"format": "bunx prettier --write \"src/**/*.{astro,svelte,ts,js,css}\" \"**/*.{md,mdx,json,yml}\"",
		"check": "astro check",
		"test": "bun run test:unit:run && CI=true bun run test:e2e",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:sync-snapshots": "find tests/e2e/visual.spec.ts-snapshots -name '*-darwin.png' -exec sh -c 'cp \"$1\" \"${1%-darwin.png}-linux.png\"' _ {} \\;",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-remark": "7.2.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/svelte": "9.0.1",
		"@data-slot/command": "^0.2.166",
		"@data-slot/dialog": "^0.2.166",
		"@data-slot/navigation-menu": "^0.2.166",
		"@data-slot/tabs": "^0.2.166",
		"@data-slot/toggle": "^0.2.166",
		"@data-slot/tooltip": "^0.2.166",
		"@iconify/svelte": "^5.2.2",
		"@lucide/astro": "^1.30.0",
		"@richardtowers/remark-abbr": "^1.1.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.1.6",
		"astro-icon": "^1.1.5",
		"astro-mermaid": "^2.1.0",
		"astro-pagefind": "^2.0.1",
		"bejamas": "^0.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hastscript": "^9.0.1",
		"mdast": "^3.0.0",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.16.1",
		"rehype-external-links": "^3.0.0",
		"remark-deflist": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-supersub": "^1.0.0",
		"satori": "^0.29.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.7",
		"@iconify-json/logos": "^1.2.12",
		"@iconify-json/ph": "^1.2.2",
		"@iconify/json": "^2.2.509",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"lefthook": "^2.1.10",
		"playwright": "^1.62.1",
		"playwright-core": "^1.62.1",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^4.1.1",
		"semantic-release": "^25.0.9",
		"shadcn": "^4.16.2",
		"tw-animate-css": "^1.4.0",
		"vitest": "^4.1.10"
	}
}
