{
	"name": "personal-web",
	"version": "1.16.0",
	"type": "module",
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome lint .",
		"format": "bun run format:code && bun run format:imports",
		"format:code": "prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"test": "bun run test:unit:run && CI=true bun run test:e2e",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:sync-snapshots": "find tests/e2e/visual.spec.ts-snapshots -name '*-darwin.png' -exec sh -c 'cp \"$1\" \"${1%-darwin.png}-linux.png\"' _ {} \\;",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@astrojs/check": "0.9.9",
		"@astrojs/markdown-remark": "7.2.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/svelte": "9.0.1",
		"@richardtowers/remark-abbr": "^1.1.5",
		"@tailwindcss/vite": "^4.3.2",
		"astro": "7.0.7",
		"astro-mermaid": "^2.1.0",
		"astro-pagefind": "^2.0.1",
		"clsx": "^2.1.1",
		"mermaid": "^11.16.0",
		"rehype-external-links": "^3.0.0",
		"remark-deflist": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-supersub": "^1.0.0",
		"satori-astro": "^0.4.0",
		"satori-html": "^0.3.2",
		"svelte": "^5.56.4",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.3",
		"@iconify-json/carbon": "^1.2.24",
		"@iconify-json/logos": "^1.2.11",
		"@iconify-json/ri": "^1.2.10",
		"@iconify/json": "^2.2.498",
		"@iconify/tailwind4": "^1.2.3",
		"@playwright/test": "^1.61.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/nprogress": "^0.2.3",
		"lefthook": "^2.1.10",
		"playwright": "^1.61.1",
		"playwright-core": "^1.61.1",
		"prettier": "3.9.5",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "0.8.0",
		"semantic-release": "^25.0.6",
		"sharp": "^0.35.3",
		"vitest": "^4.1.10"
	}
}
