{
	"name": "pictogrammer",
	"version": "1.31.0",
	"type": "module",
	"description": "Personal website and blog of Khoirul Fattah — full-stack projects, technical writing, and photography.",
	"homepage": "https://khoirul.me",
	"repository": {
		"type": "git",
		"url": "https://github.com/masmuss/pictogrammer"
	},
	"license": "MIT",
	"author": {
		"name": "Ahmad Musafir Khoirul Fattah",
		"email": "hello@khoirul.me",
		"url": "https://khoirul.me"
	},
	"keywords": [
		"personal-website",
		"portfolio",
		"blog",
		"astro",
		"tailwindcss",
		"svelte"
	],
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"format": "bun run format:biome && bun run format:prettier",
		"format:biome": "bunx --bun @biomejs/biome format --write",
		"format:prettier": "bunx prettier --write \"**/*.md\" \"**/*.mdx\"",
		"check": "astro check",
		"test": "bun run test:unit:run && CI=true bun run test:e2e",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:sync-snapshots": "find tests/e2e/visual.spec.ts-snapshots -name '*-darwin.png' -exec sh -c 'cp \"$1\" \"${1%-darwin.png}-linux.png\"' _ {} \\;",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-remark": "7.2.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/svelte": "9.0.1",
		"@iconify/tailwind4": "^1.2.3",
		"@richardtowers/remark-abbr": "^1.1.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "7.1.5",
		"astro-mermaid": "^2.1.0",
		"astro-pagefind": "^2.0.1",
		"clsx": "^2.1.1",
		"hastscript": "^9.0.1",
		"mdast": "^3.0.0",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"mermaid": "^11.16.0",
		"rehype-external-links": "^3.0.0",
		"remark-deflist": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-supersub": "^1.0.0",
		"satori": "^0.26.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.3",
		"svelte": "^5.56.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "2.5.6",
		"@iconify-json/logos": "^1.2.11",
		"@iconify-json/ri": "^1.2.10",
		"@iconify/json": "^2.2.507",
		"@playwright/test": "^1.62.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"lefthook": "^2.1.10",
		"playwright": "^1.62.0",
		"playwright-core": "^1.62.0",
		"prettier": "3.9.6",
		"semantic-release": "^25.0.8",
		"vitest": "^4.1.10"
	}
}
