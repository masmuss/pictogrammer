{
	"name": "pictogrammer",
	"version": "2.7.0",
	"type": "module",
	"description": "Personal website and blog of Khoirul Fattah — full-stack projects, technical writing, and photography.",
	"homepage": "https://khoirul.me",
	"repository": {
		"type": "git",
		"url": "https://github.com/masmuss/pictogrammer"
	},
	"license": "MIT",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.0.0"
	},
	"packageManager": "bun@1.4.4",
	"author": {
		"name": "Ahmad Musafir Khoirul Fattah",
		"email": "hello@khoirul.me",
		"url": "https://khoirul.me"
	},
	"keywords": [
		"personal-website",
		"portfolio",
		"blog",
		"astro",
		"tailwindcss"
	],
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"lint:ci": "bunx --bun @biomejs/biome ci",
		"format": "bunx --bun @biomejs/biome format --write",
		"check": "astro check",
		"test": "bun run test:unit:run && CI=true bun run test:e2e",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"cf:dev": "wrangler dev",
		"deploy": "astro build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/check": "0.9.12",
		"@astrojs/markdown-remark": "7.3.6",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@data-slot/dialog": "^1.1.3",
		"@data-slot/tooltip": "^1.1.3",
		"@richardtowers/remark-abbr": "^1.1.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"astro": "7.4.7",
		"astro-icon": "^1.2.0",
		"astro-pagefind": "^2.0.1",
		"bejamas": "^0.6.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hastscript": "^9.0.3",
		"markdown-it": "^15.0.3",
		"mdast": "^3.0.0",
		"mdast-util-directive": "^3.2.0",
		"mdast-util-to-markdown": "^2.2.2",
		"mdast-util-to-string": "^4.0.0",
		"pele": "^1.13.0",
		"rehype-external-links": "^3.0.0",
		"remark-deflist": "^1.0.0",
		"remark-directive": "^4.0.0",
		"remark-supersub": "^1.0.0",
		"sanitize-html": "^2.18.1",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"typescript": "~6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.6",
		"@iconify-json/ph": "^1.2.2",
		"@iconify/json": "^2.2.553",
		"@playwright/test": "^1.65.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/sanitize-html": "^2.16.2",
		"astro-md-content-negotiation": "^0.1.5",
		"lefthook": "^2.2.2",
		"lodash-es": "4.18.1",
		"playwright": "^1.65.0",
		"playwright-core": "^1.65.0",
		"semantic-release": "^25.0.9",
		"tw-animate-css": "^1.4.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	}
}
